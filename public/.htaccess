# Team-Neudorf – Apache-Konfiguration für das statische Build (dist/).
# UNGETESTET auf dem Zielhosting: vor dem Livegang auf dem echten Server prüfen.
# Alle bisherigen URLs (…/polizei.html usw.) bleiben unverändert erhalten – es sind
# deshalb keine inhaltlichen 301-Weiterleitungen nötig, nur Vereinheitlichungen.

ErrorDocument 404 /404.html
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1) Einheitlich https + www (eine kanonische Adresse)
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule ^ https://www.%1%{REQUEST_URI} [R=301,L]

  # 2) /index.html -> / (Startseite nur unter einer Adresse)
  RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [R=301,L]

  # 3) Adressen ohne Endung (z. B. /polizei oder /polizei/) -> bestehende .html-Seite
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^([a-z0-9-]+)/?$ /$1.html [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  # Dateien mit Hash im Namen dürfen dauerhaft gecacht werden
  <FilesMatch "\.(?:css|js|woff2?|avif|webp|jpg|png|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(?:html|xml|txt)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  <Files "favicon.svg">
    Header set Cache-Control "public, max-age=86400"
  </Files>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/xml image/svg+xml text/plain
</IfModule>
