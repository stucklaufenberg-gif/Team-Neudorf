---
import '@fontsource-variable/inter/wght.css';
import '@fontsource/instrument-serif/latin-400.css';
import '@fontsource/instrument-serif/latin-400-italic.css';
import '@fontsource/jetbrains-mono/latin-400.css';
import '@fontsource/jetbrains-mono/latin-500.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import { isPreview } from '../data/env';

interface Props {
  title: string;
  description: string;
  /** Pfad der Seite inkl. .html, z. B. "/polizei.html" – Grundlage für Canonical-URL. */
  path: string;
  noindex?: boolean;
  jsonLd?: unknown[];
  home?: boolean;
  /** Kennung, falls die Seite eine Kampagnen-Landingpage ist (für landingpage_view). */
  landingpage?: string;
}
const { title, description, path, noindex = false, jsonLd = [], home = false, landingpage } = Astro.props;
const canonical = site.url + (path === '/index.html' ? '/' : path);
// Schnellkontakt (mobil) entfällt auf Seiten, die selbst Formular bzw. Bestätigung sind.
const quick = !['/kontakt.html', '/schaden-melden.html', '/danke.html', '/schaden-danke.html', '/404.html'].includes(path);
const ogImage = site.url + '/assets/images/logo-header.png';
---
<!doctype html>
<html lang="de" data-preview={isPreview ? '' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {(noindex || isPreview) && <meta name="robots" content={isPreview ? 'noindex, nofollow' : 'noindex'} />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#011D37" />
    <meta name="format-detection" content="telephone=no" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.short} />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body class:list={[{ 'is-home': home }]} data-landingpage={landingpage}>
    <a class="skip-link" href="#main">Zum Inhalt springen</a>
    {isPreview && <p class="preview-flag" role="note">Testumgebung · nicht öffentlich</p>}
    <Header path={path} />
    <main id="main">
      <slot />
    </main>
    <Footer showTrust={!home} />
    {quick && (
      <nav class="quickbar" data-quickbar aria-label="Schnellkontakt">
        <a href={site.phoneHref}><Icon name="phone" size={18} />Anrufen</a>
        <a href={site.whatsapp} target="_blank" rel="noopener" aria-label="Team-Neudorf per WhatsApp schreiben (neues Fenster)"><Icon name="whatsapp" size={18} />WhatsApp</a>
        <a class="quickbar__primary" href="/kontakt.html">Gespräch anfragen</a>
      </nav>
    )}
    <script>
      import '../scripts/main.ts';
    </script>
  </body>
</html>
