---
// Kelder-Motiv: hauchdünne „Silk-Lines“, die sich beim Erscheinen selbst zeichnen.
// Rein dekorativ (aria-hidden). Animation per CSS, bei reduced-motion statisch sichtbar.
// scrub: Linien zeichnen sich an den Scrollfortschritt gekoppelt (statt einmalig beim Erscheinen).
interface Props { variant?: 'flow' | 'arc' | 'rise'; class?: string; count?: number; scrub?: boolean }
const { variant = 'flow', class: cls = '', count = 7, scrub = false } = Astro.props;
const id = 'silk-' + variant + '-' + Math.random().toString(36).slice(2, 7);
const paths: string[] = [];
for (let i = 0; i < count; i++) {
  const o = i * 13;
  if (variant === 'flow') paths.push(`M-40 ${70 + o} C 260 ${-30 + o * 1.5}, 520 ${330 - o}, 820 ${190 + o * 0.6} S 1260 ${40 + o * 1.4}, 1480 ${230 - o * 0.5}`);
  else if (variant === 'arc') paths.push(`M-40 ${330 - o * 0.4} C 300 ${300 - o * 2.2}, 700 ${40 + o * 1.8}, 1480 ${90 + o * 1.3}`);
  else paths.push(`M-40 ${300 - o * 0.3} C 380 ${320 - o}, 640 ${120 + o * 1.6}, 980 ${150 + o * 0.5} S 1320 ${60 + o}, 1480 ${20 + o * 1.6}`);
}
---
<svg class:list={['silk', cls]} viewBox="0 0 1440 360" preserveAspectRatio="none" aria-hidden="true" focusable="false" data-reveal={scrub ? undefined : ''} data-scrub={scrub ? '' : undefined}>
  <defs>
    <linearGradient id={id} x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#d9b25a" stop-opacity="0" />
      <stop offset=".22" stop-color="#d9b25a" stop-opacity=".9" />
      <stop offset=".62" stop-color="#8ec5f0" stop-opacity=".55" />
      <stop offset="1" stop-color="#8ec5f0" stop-opacity="0" />
    </linearGradient>
  </defs>
  {paths.map((d, i) => (
    <path d={d} pathLength="1" fill="none" stroke={`url(#${id})`} stroke-width="1" vector-effect="non-scaling-stroke" style={`--i:${i};opacity:${(1 - i / (count * 1.25)).toFixed(2)}`} />
  ))}
</svg>
