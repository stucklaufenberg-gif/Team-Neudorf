              <li><span class="tick"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"/></svg></span><span><strong>Erreichbar:</strong> Montag bis Donnerstag 9 bis 17 Uhr, Freitag 9 bis 14 Uhr</span></li>
              <li><span class="tick"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"/></svg></span><span><strong>Vor Ort:</strong> im Büro oder bei Ihnen, nach Terminvereinbarung</span></li>
