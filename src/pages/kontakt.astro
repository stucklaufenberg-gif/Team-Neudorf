              var texte = {
                '1': '<strong>Bitte prüfen Sie Ihre Angaben.</strong> Füllen Sie alle Pflichtfelder aus und stimmen Sie der Datenschutzerklärung zu.',
                '2': '<strong>Ihre Anfrage konnte gerade nicht versendet werden.</strong> Bitte versuchen Sie es in einigen Minuten erneut, schreiben Sie uns an <a href="mailto:info@team-neudorf.de">info@team-neudorf.de</a> oder rufen Sie uns an: <a href="tel:+4922569596141">02256 9596141</a>.'
