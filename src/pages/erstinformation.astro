---
// Automatisch aus legacy/erstinformation.html migriert (scripts/migrate-legacy.py).
// Inhalte stammen wörtlich von der bestehenden Website www.team-neudorf.de.
import Base from '../layouts/Base.astro';
const jsonLd: unknown[] = [];
---
<Base title={"Erstinformation | Team-Neudorf"} description={"Erstinformation für Versicherungsvermittler gemäß § 15 VersVermV von Team-Neudorf."} path="/erstinformation.html" noindex jsonLd={jsonLd}>
<section class="page-hero">
      <div class="container">
        <nav class="breadcrumbs" aria-label="Brotkrümel"><a href="/">Start</a> / Erstinformation</nav>
        <h1>Erstinformation</h1>
        <p>Informationen des Versicherungsvermittlers gemäß § 15 VersVermV.</p>
      </div>
    </section>
    <section class="section">
      <div class="container prose">
        <h2>Wer wir sind</h2>
        <p>
          Team-Neudorf Versicherungen<br>
          An der Quelle 1<br>
          53894 Mechernich<br>
          Telefon: <a href="tel:+4922569596141">02256 9596141</a><br>
          E-Mail: <a href="mailto:info@team-neudorf.de">info@team-neudorf.de</a>
        </p>
        <h2>Unser Status</h2>
        <ul>
          <li>Wir sind tätig als <strong>Versicherungsmakler</strong> mit Erlaubnis nach § 34d Abs. 1 GewO.</li>
          <li>Erteilt durch (zuständige IHK): Industrie- und Handelskammer Aachen, Theaterstraße 6-10, 52062 Aachen</li>
        </ul>
        <h2>Registrierung im Vermittlerregister</h2>
        <p>Wir sind im Vermittlerregister eingetragen:</p>
        <ul>
          <li>Registrierungsnummer: D-VFQ8-W94TM-15</li>
          <li>Registerführende Stelle: Deutsche Industrie- und Handelskammer (DIHK) e.V.,
              Breite Straße 29, 10178 Berlin</li>
          <li>Überprüfung unter: <a href="https://www.vermittlerregister.info" target="_blank" rel="noopener">www.vermittlerregister.info</a></li>
        </ul>
        <h2>Beratung</h2>
        <p>Als Versicherungsmakler bieten wir Ihnen eine <strong>Beratung</strong> an. Unserer Beratung
           und Vermittlung legen wir eine hinreichende Zahl von auf dem Markt angebotenen
           Versicherungsverträgen und Versicherern zugrunde. Auf dieser Grundlage sprechen wir Ihnen
           eine fachlich fundierte Empfehlung aus, welcher Versicherungsvertrag geeignet ist, Ihre
           Bedürfnisse zu erfüllen (§ 60 Abs. 1 VVG).</p>
        <h2>Vergütung</h2>
        <p>Für unsere Vermittlungstätigkeit erhalten wir eine <strong>Courtage (Provision)</strong> vom
           jeweiligen Versicherungsunternehmen. Diese ist bereits in der von Ihnen zu zahlenden
           Versicherungsprämie enthalten; eine gesonderte Zahlung durch Sie erfolgt hierfür nicht.
           Ein separates Honorar berechnen wir Ihnen für die Vermittlung nicht.</p>
        <h2>Beteiligungen</h2>
        <p>Wir halten keine unmittelbare oder mittelbare Beteiligung von über 10 % an den
           Stimmrechten oder am Kapital eines Versicherungsunternehmens. Ebenso hält kein
           Versicherungsunternehmen eine unmittelbare oder mittelbare Beteiligung von über 10 %
           an unseren Stimmrechten oder unserem Kapital (§ 15 VersVermV).</p>
        <h2>Schlichtungsstellen</h2>
        <p>Bei Streitigkeiten können Sie sich an folgende unabhängige Schlichtungsstellen wenden:</p>
        <ul>
          <li>Versicherungsombudsmann e.V., Postfach 08 06 32, 10006 Berlin,
            <a href="https://www.versicherungsombudsmann.de" target="_blank" rel="noopener">www.versicherungsombudsmann.de</a></li>
          <li>Ombudsmann Private Kranken- und Pflegeversicherung, Postfach 06 02 22, 10052 Berlin,
            <a href="https://www.pkv-ombudsmann.de" target="_blank" rel="noopener">www.pkv-ombudsmann.de</a></li>
        </ul>
        <p class="u-muted u-small u-mt-l">
          Stand: September 2026
        </p>
      </div>
    </section>
</Base>
