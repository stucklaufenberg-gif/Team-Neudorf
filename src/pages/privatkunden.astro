---
// Automatisch aus legacy/privatkunden.html migriert (scripts/migrate-legacy.py).
// Inhalte stammen wörtlich von der bestehenden Website www.team-neudorf.de.
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import { Picture } from 'astro:assets';
import imgSpartenPrivatkunden from '../assets/images/sparten/privatkunden.jpg';
const jsonLd: unknown[] = [];
---
<Base title={"Versicherungen für Privatkunden in Mechernich | Team-Neudorf"} description={"Persönliche Beratung für Privatkunden in Mechernich und Umgebung: Haftpflicht, Hausrat, Kfz, Unfall, Rechtsschutz, Berufsunfähigkeit, Kranken und Vorsorge."} path="/privatkunden.html" jsonLd={jsonLd}>
<section class="page-hero page-hero--split">
      <div class="container page-hero__grid">
        <div class="page-hero__text">
          <nav class="breadcrumbs" aria-label="Brotkrümel"><a href="/">Start</a> / Privatkunden</nav>
        <h1>Versicherungen für Privatpersonen</h1>
        <p>Als Versicherungsmakler sind wir für <strong>alle</strong> da. Ob Familie, Berufseinsteiger oder Selbstständige: Wir helfen Ihnen, den passenden Schutz zu finden, verständlich erklärt und ganz ohne Druck.</p>
        </div>
        <figure class="page-hero__media foto-privatkunden">
          <Picture src={imgSpartenPrivatkunden} alt="Familie sitzt auf einer Anhöhe und blickt über die Hügellandschaft" formats={["avif", "webp"]} widths={[640, 1000, 1400, 1920]} sizes="(max-width: 900px) 100vw, 50vw" loading="eager" fetchpriority="high" />
        </figure>
      </div>
    </section>
    <section class="section">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">Alles aus einer Hand</span>
          <h2>Ihre Absicherung, anbieterübergreifend verglichen</h2>
          <p>Von der Haftpflicht bis zur Altersvorsorge kümmern wir uns gemeinsam um alles, was zu Ihrem Leben passt, verständlich erklärt und alles aus einer Hand.</p>
        </div>
        <span class="eyebrow u-block u-mb-m">Haftung &amp; Recht</span>
        <div class="grid grid--3">
          <article class="card">
            <div class="card__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.96 11.96 0 0 1 3.598 6 12 12 0 0 0 3 9.75c0 5.592 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.75a11.96 11.96 0 0 1-8.402-3.286Z"/></svg></div>
            <h3>Privathaftpflicht</h3>
            <p>Der wichtigste Basisschutz: Sie deckt Schäden ab, die Sie versehentlich anderen zufügen, oft mit existenzieller Bedeutung.</p>
          </article>
          <article class="card">
            <div class="card__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z"/></svg></div>
            <h3>Tierhalter-Haftpflicht</h3>
            <p>Für Hunde- und Pferdehalter unverzichtbar: Sie übernimmt Schäden, die Ihr Tier verursacht.</p>
          </article>
          <article class="card">
            <div class="card__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v17.25m0 0c-1.472 0-2.882.265-4.185.75M12 20.25c1.472 0 2.882.265 4.185.75M18.75 4.97A48.416 48.416 0 0 0 12 4.5c-2.291 0-4.545.16-6.75.47m13.5 0c1.01.143 2.01.317 3 .52m-3-.52 2.62 10.726c.122.499-.106 1.028-.589 1.202a5.988 5.988 0 0 1-2.031.352 5.988 5.988 0 0 1-2.031-.352c-.483-.174-.711-.703-.59-1.202L18.75 4.971Zm-16.5.52c.99-.203 1.99-.377 3-.52m0 0 2.62 10.726c.122.499-.106 1.028-.589 1.202a5.989 5.989 0 0 1-2.031.352 5.989 5.989 0 0 1-2.031-.352c-.483-.174-.711-.703-.59-1.202L5.25 4.971Z"/></svg></div>
            <h3>Rechtsschutz</h3>
            <p>Setzen Sie Ihr Recht durch, ohne das Kostenrisiko zu fürchten: für Beruf, Verkehr, Wohnen und privat.</p>
          </article>
        </div>
        <span class="eyebrow u-block u-mt-xl u-mb-m">Hab &amp; Gut</span>
        <div class="grid grid--3">
          <article class="card">
            <div class="card__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path stroke-linecap="round" stroke-linejoin="round" d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25"/></svg></div>
            <h3>Hausratversicherung</h3>
            <p>Schützt Ihr Zuhause und Ihren Besitz gegen Feuer, Einbruch, Leitungswasser und Sturm.</p>
          </article>
          <article class="card">
            <div class="card__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21a.75.75 0 0 1 .75.75V21"/></svg></div>
            <h3>Wohngebäude</h3>
            <p>Für Eigentümer: Schutz für Haus und Gebäude gegen Feuer, Sturm, Leitungswasser und Elementarschäden.</p>
          </article>
          <article class="card">
            <div class="card__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 0 1-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 0 0-3.213-9.193 2.056 2.056 0 0 0-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 0 0-10.026 0 1.106 1.106 0 0 0-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12"/></svg></div>
            <h3>Kfz-Versicherung</h3>
            <p>Von Haftpflicht bis Vollkasko: fair verglichen, mit den passenden Konditionen für Ihr Fahrzeug.</p>
          </article>
        </div>
      </div>
    </section>
    <section class="section section--soft">
      <div class="container">
        <span class="eyebrow u-block u-mb-m">Gesundheit &amp; Einkommen</span>
        <div class="grid grid--2">
          <article class="card">
            <div class="card__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z"/></svg></div>
            <h3>Kranken­versicherung &amp; Zusatz</h3>
            <p>Gesetzlich oder privat, dazu sinnvolle Zusatzbausteine für Zähne, Brille, Heilpraktiker oder das Krankenhaus.</p>
          </article>
          <article class="card">
            <div class="card__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.96 11.96 0 0 1 3.598 6 12 12 0 0 0 3 9.75c0 5.592 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.75a11.96 11.96 0 0 1-8.402-3.286Z"/></svg></div>
            <h3>Berufsunfähigkeit</h3>
            <p>Ihre Arbeitskraft ist Ihr größtes Kapital. Fällt sie weg, sichert die BU Ihr Einkommen. Für viele ist sie die wichtigste Versicherung überhaupt.</p>
          </article>
          <article class="card">
            <div class="card__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z"/></svg></div>
            <h3>Unfallversicherung</h3>
            <p>Finanzieller Schutz nach einem Unfall: rund um die Uhr, im Beruf und in der Freizeit.</p>
          </article>
          <article class="card">
            <div class="card__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z"/></svg></div>
            <h3>Pflegevorsorge</h3>
            <p>Pflege ist teuer. Eine Pflegezusatzversicherung schließt die Lücke zur gesetzlichen Leistung und schützt Ihr Vermögen.</p>
          </article>
        </div>
        <span class="eyebrow u-block u-mt-xl u-mb-m">Vorsorge &amp; Familie</span>
        <div class="grid grid--2">
          <article class="card">
            <div class="card__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0 1 15.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 0 1 3 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 0 0-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 0 1-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 0 0 3 15h-.75M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/></svg></div>
            <h3>Altersvorsorge &amp; private Rente</h3>
            <p>Bauen Sie sich eine zusätzliche Rente auf: flexibel, steuerlich clever und abgestimmt auf Ihre Ziele.</p>
          </article>
          <article class="card">
            <div class="card__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z"/></svg></div>
            <h3>Risikolebensversicherung</h3>
            <p>Sichert Ihre Familie oder Ihre Immobilie finanziell ab, falls Ihnen etwas zustößt, gerade für Eltern und Kreditnehmer wichtig.</p>
          </article>
        </div>
        <div class="notice notice--info u-mt-xl">
          <strong>Ihre Sparte ist nicht dabei?</strong> Kein Problem: Als Makler decken wir nahezu alle Bereiche ab. Sprechen Sie uns einfach an.
        </div>
      </div>
    </section>
    <CtaBand eyebrow="Persönlich &amp; verständlich" href="/kontakt.html" label="Jetzt Kontakt aufnehmen">
<Fragment slot="title">Lassen Sie uns über Ihre Absicherung sprechen</Fragment>
<p>Ein unverbindliches Erstgespräch zeigt schnell, wo Sie gut aufgestellt sind und wo sich Lücken oder Sparpotenziale verstecken.</p>
</CtaBand>
</Base>
