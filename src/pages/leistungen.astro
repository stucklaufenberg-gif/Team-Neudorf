---
// Automatisch aus legacy/leistungen.html migriert (scripts/migrate-legacy.py).
// Inhalte stammen wörtlich von der bestehenden Website www.team-neudorf.de.
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
const jsonLd: unknown[] = [];
---
<Base title={"Leistungen für den Öffentlichen Dienst | Team-Neudorf"} description={"Dienstunfähigkeit, PKV mit Beihilfe, Heilfürsorge, Anwartschaft, Diensthaftpflicht und Altersvorsorge: unsere Leistungen für den Öffentlichen Dienst."} path="/leistungen.html" jsonLd={jsonLd}>
<section class="page-hero">
      <div class="container">
        <nav class="breadcrumbs" aria-label="Brotkrümel"><a href="/">Start</a> / Leistungen</nav>
        <h1>Unsere Leistungen</h1>
        <p>Von den ersten Schritten im Beruf bis zum Ruhestand: Wir begleiten Sie durch alle wichtigen Themen, verständlich erklärt und ganz auf den Öffentlichen Dienst zugeschnitten.</p>
      </div>
    </section>
    <section class="section">
      <div class="container">
        <div class="grid grid--2">
          <article class="card" id="dienstunfaehigkeit">
            <div class="card__icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.96 11.96 0 0 1 3.598 6 12 12 0 0 0 3 9.75c0 5.592 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.75a11.96 11.96 0 0 1-8.402-3.286Z"/></svg>
            </div>
            <h3>Dienstunfähigkeit &amp; Berufsunfähigkeit</h3>
            <p>Wer aus gesundheitlichen Gründen nicht mehr arbeiten kann, gerät schnell in eine finanzielle Notlage. Für Beamtinnen und Beamte gelten dabei besondere Regeln.</p>
            <ul class="checklist">
              <li><span class="tick"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"/></svg></span><span>Berufsunfähigkeitsschutz mit echter Dienstunfähigkeitsklausel</span></li>
              <li><span class="tick"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"/></svg></span><span>Absicherung der Versorgungslücke, besonders in den ersten Dienstjahren</span></li>
              <li><span class="tick"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"/></svg></span><span>Vergleich der Anbieter und Bedingungen im Detail</span></li>
            </ul>
          </article>
          <article class="card" id="krankenversicherung">
            <div class="card__icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z"/></svg>
            </div>
            <h3>Private Krankenversicherung &amp; Beihilfe</h3>
            <p>Als Beamtin oder Beamter erhalten Sie Beihilfe. Die private Krankenversicherung ergänzt genau den Teil, den die Beihilfe nicht übernimmt.</p>
            <ul class="checklist">
              <li><span class="tick"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"/></svg></span><span>Beihilfekonforme Tarife passend zu Ihrem Beihilfesatz</span></li>
              <li><span class="tick"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"/></svg></span><span>Absicherung für Familie und Kinder mitgedacht</span></li>
              <li><span class="tick"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"/></svg></span><span>Vergleich von Leistung, Beitrag und Anbieterstärke</span></li>
            </ul>
          </article>
          <article class="card" id="heilfuersorge">
            <div class="card__icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 0 1-1.043 3.296 3.745 3.745 0 0 1-3.296 1.043A3.745 3.745 0 0 1 12 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 0 1-3.296-1.043 3.745 3.745 0 0 1-1.043-3.296A3.745 3.745 0 0 1 3 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 0 1 1.043-3.296 3.746 3.746 0 0 1 3.296-1.043A3.746 3.746 0 0 1 12 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 0 1 3.296 1.043 3.746 3.746 0 0 1 1.043 3.296A3.745 3.745 0 0 1 21 12Z"/></svg>
            </div>
            <h3>Heilfürsorge &amp; truppenärztliche Versorgung</h3>
            <p>Polizei, Berufsfeuerwehr sowie Soldatinnen und Soldaten (je nach Bundesland auch der Justizvollzug) erhalten im aktiven Dienst freie Heilfürsorge bzw. truppenärztliche Versorgung: Die Krankheitskosten trägt der Dienstherr. Der wichtige Blick geht auf die Zeit danach.</p>
            <ul class="checklist">
              <li><span class="tick"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"/></svg></span><span>Anwartschaft sichern: Zugang zur privaten Krankenversicherung zu heutigen Konditionen für die Zeit nach dem Dienst</span></li>
              <li><span class="tick"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"/></svg></span><span>Sinnvolle Ergänzungen zur Heilfürsorge, z. B. Wahlleistungen im Krankenhaus, Zahnersatz oder Ausland</span></li>
              <li><span class="tick"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"/></svg></span><span>Rechtzeitig planen, was beim Übergang in die Beihilfe (z. B. im Ruhestand) zu beachten ist</span></li>
            </ul>
          </article>
          <article class="card" id="altersvorsorge">
            <div class="card__icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 8.25h19.5M2.25 9.75h19.5m-16.5 4.5h6m-6 3h3M4.125 6h15.75c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125H4.125A1.125 1.125 0 0 1 3 16.875v-9.75C3 6.504 3.504 6 4.125 6Z"/></svg>
            </div>
            <h3>Altersvorsorge &amp; Pensionslücke</h3>
            <p>Die Pension ersetzt nicht das volle letzte Gehalt. Und wer die volle Pension nicht erreicht, hat oft eine spürbare Lücke. Wir rechnen das ehrlich durch.</p>
            <ul class="checklist">
              <li><span class="tick"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"/></svg></span><span>Ermittlung Ihrer voraussichtlichen Versorgungslücke</span></li>
              <li><span class="tick"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"/></svg></span><span>Geförderte und flexible Vorsorgewege im Vergleich</span></li>
              <li><span class="tick"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"/></svg></span><span>Planung mit Blick auf Steuer und Ruhestandsbeginn</span></li>
            </ul>
          </article>
          <article class="card" id="diensthaftpflicht">
            <div class="card__icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v17.25m0 0c-1.472 0-2.882.265-4.185.75M12 20.25c1.472 0 2.882.265 4.185.75M18.75 4.97A48.416 48.416 0 0 0 12 4.5c-2.291 0-4.545.16-6.75.47m13.5 0c1.01.143 2.01.317 3 .52m-3-.52 2.62 10.726c.122.499-.106 1.028-.589 1.202a5.988 5.988 0 0 1-2.031.352 5.988 5.988 0 0 1-2.031-.352c-.483-.174-.711-.703-.59-1.202L18.75 4.971Zm-16.5.52c.99-.203 1.99-.377 3-.52m0 0 2.62 10.726c.122.499-.106 1.028-.589 1.202a5.989 5.989 0 0 1-2.031.352 5.989 5.989 0 0 1-2.031-.352c-.483-.174-.711-.703-.59-1.202L5.25 4.971Z"/></svg>
            </div>
            <h3>Diensthaftpflicht &amp; Rechtsschutz</h3>
            <p>Ein dienstlich verursachter Schaden kann teuer werden, etwa bei Lehrkräften, Polizei oder in der Verwaltung. Die passende Absicherung nimmt den Druck.</p>
            <ul class="checklist">
              <li><span class="tick"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"/></svg></span><span>Diensthaftpflicht für berufliche Risiken im Öffentlichen Dienst</span></li>
              <li><span class="tick"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"/></svg></span><span>Rechtsschutz für Beruf, Privatleben und Verkehr</span></li>
              <li><span class="tick"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"/></svg></span><span>Abgestimmt auf Ihre konkrete Tätigkeit</span></li>
            </ul>
          </article>
          <article class="card" id="sachwerte">
            <div class="card__icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path stroke-linecap="round" stroke-linejoin="round" d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75"/></svg>
            </div>
            <h3>Eigentum, Haftpflicht &amp; Alltagsschutz</h3>
            <p>Der solide Grundschutz für den Alltag, oft mit erstaunlich viel Sparpotenzial, wenn man die Anbieter einmal richtig vergleicht.</p>
            <ul class="checklist">
              <li><span class="tick"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"/></svg></span><span>Privathaftpflicht, Hausrat und Wohngebäude</span></li>
              <li><span class="tick"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"/></svg></span><span>Kfz-Versicherung mit Blick auf faire Konditionen</span></li>
              <li><span class="tick"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"/></svg></span><span>Bestehende Verträge prüfen und optimieren</span></li>
            </ul>
          </article>
          <article class="card" id="familie">
            <div class="card__icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z"/></svg>
            </div>
            <h3>Familie &amp; Hinterbliebenenschutz</h3>
            <p>Wenn Menschen von Ihrem Einkommen abhängen, sorgt der richtige Schutz dafür, dass Ihre Familie im Ernstfall abgesichert bleibt.</p>
            <ul class="checklist">
              <li><span class="tick"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"/></svg></span><span>Risikolebensversicherung für Familie und Immobilie</span></li>
              <li><span class="tick"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"/></svg></span><span>Unfallversicherung und Vorsorge für den Pflegefall</span></li>
              <li><span class="tick"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"/></svg></span><span>Absicherung abgestimmt auf Ihre Lebenssituation</span></li>
            </ul>
          </article>
        </div>
        <div class="notice notice--info u-mt-xl">
          <strong>Hinweis:</strong> Die Inhalte auf dieser Seite dienen der allgemeinen Information und ersetzen keine individuelle Beratung. Welche Absicherung für Sie sinnvoll ist, hängt von Ihrer persönlichen Situation ab. Genau das klären wir gemeinsam in einem Gespräch.
        </div>
      </div>
    </section>
    <section class="section section--soft">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">Wichtig für später</span>
          <h2>Kleine oder große Anwartschaft: Was bedeutet das fürs Alter?</h2>
          <p>Wenn Sie eine Zeit lang nicht privat krankenversichert sind (etwa während der Heilfürsorge, der truppenärztlichen Versorgung oder in der Elternzeit), hält Ihnen eine Anwartschaft den Weg zurück in die private Krankenversicherung offen. Sie kommen später ganz ohne neue Gesundheitsprüfung wieder hinein. Es gibt zwei Varianten:</p>
        </div>
        <div class="grid grid--2">
          <article class="card">
            <div class="card__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/></svg></div>
            <h3>Kleine Anwartschaft</h3>
            <p>Sichert Ihren <strong>Gesundheitszustand</strong>: Sie kommen später ohne erneute Gesundheitsprüfung in die PKV, ganz gleich, was zwischenzeitlich gesundheitlich passiert.</p>
            <ul class="checklist">
              <li><span class="tick"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"/></svg></span><span>Günstiger monatlicher Beitrag in der Anwartschaftszeit</span></li>
              <li><span class="tick"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"/></svg></span><span>Der spätere Beitrag richtet sich nach Ihrem dann höheren Eintrittsalter</span></li>
              <li><span class="tick"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"/></svg></span><span>Gut, wenn vor allem der Zugang gesichert sein soll</span></li>
            </ul>
          </article>
          <article class="card">
            <div class="card__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18 9 11.25l4.306 4.306a11.95 11.95 0 0 1 5.814-5.517l2.74-1.22m0 0-5.94-2.281m5.94 2.28-2.28 5.941"/></svg></div>
            <h3>Große Anwartschaft</h3>
            <p>Sichert <strong>Gesundheitszustand und Alterungsrückstellungen</strong>: Ihr späterer Beitrag wird so berechnet, als wären Sie schon seit dem ursprünglichen Eintritt versichert.</p>
            <ul class="checklist">
              <li><span class="tick"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"/></svg></span><span>Etwas höherer Beitrag in der Anwartschaftszeit</span></li>
              <li><span class="tick"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"/></svg></span><span>Dafür bleibt Ihr PKV-Beitrag <strong>im Alter deutlich niedriger</strong></span></li>
              <li><span class="tick"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"/></svg></span><span>Ideal, wenn Sie später sicher in die PKV zurückkehren, z. B. mit Beihilfe im Ruhestand</span></li>
            </ul>
          </article>
        </div>
        <div class="notice notice--info u-mt-l">
          <strong>Auswirkung im Alter:</strong> Genau hier liegt der große Unterschied. Die große Anwartschaft baut Alterungsrückstellungen auf und hält Ihren Beitrag im Ruhestand spürbar niedrig. Die kleine tut das nicht. Was sich für Sie mehr lohnt, hängt von Ihrer Situation ab. Das rechnen wir in Ruhe gemeinsam durch.
        </div>
        <div class="text-center u-mt-l">
          <a class="btn btn--outline" href="/anwartschaft.html">Mehr zur Anwartschaft</a>
          <a class="btn btn--accent" href="/kontakt.html">Anwartschaft prüfen lassen</a>
        </div>
      </div>
    </section>
    <CtaBand eyebrow="Ihr Thema ist dabei?" href="/kontakt.html" label="Beratung anfragen">
<Fragment slot="title">Wir schauen uns Ihre Situation gemeinsam an</Fragment>
<p>Sagen Sie uns, worum es geht. Wir melden uns zeitnah für ein unverbindliches Erstgespräch.</p>
</CtaBand>
</Base>
