import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
const jsonLd: unknown[] = [];
---
<Base title={"Berufsgruppen im Öffentlichen Dienst | Team-Neudorf"} description={"Absicherung passend zu Ihrer Laufbahn: Polizei, Feuerwehr, Zoll, Bundeswehr, Lehramt, Verwaltung, Justiz, Ordnungsamt sowie Sozial- und Erziehungsdienst."} path="/berufsgruppen.html" jsonLd={jsonLd}>
<section class="page-hero">
      <div class="container">
        <nav class="breadcrumbs" aria-label="Brotkrümel"><a href="/">Start</a> / Berufsgruppen</nav>
        <h1>Absicherung für Ihre Berufsgruppe</h1>
        <p>Ob Streifenwagen, Kaserne, Klassenzimmer, Amtsstube oder Gerichtssaal: Jede Laufbahn im Öffentlichen Dienst hat ihre eigenen Regeln und Risiken. Finden Sie hier die Absicherung, die zu Ihrem Beruf passt.</p>
      </div>
    </section>
    <section class="section">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">Für wen wir da sind</span>
          <h2>Wählen Sie Ihre Laufbahn</h2>
          <p>Klicken Sie auf Ihre Berufsgruppe. Dort finden Sie die Themen, die für Sie und Ihren Beruf wirklich wichtig sind.</p>
        </div>
        <div class="grid grid--3">
          <a class="card card--link" href="/polizei.html">
            <div class="card__icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path stroke-linecap="round" stroke-linejoin="round" d="M12 2.25l7.5 3v5.25c0 4.66-3.2 8.5-7.5 9.75-4.3-1.25-7.5-5.09-7.5-9.75V5.25l7.5-3z"/></svg>
            </div>
            <h3>Polizei</h3>
            <p>Polizeivollzugsdienst: Heilfürsorge, Polizeidienstunfähigkeit und Einsatzrisiken richtig abgesichert.</p>
          </a>
          <a class="card card--link" href="/berufsfeuerwehr.html">
            <div class="card__icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path stroke-linecap="round" stroke-linejoin="round" d="M15.362 5.214A8.252 8.252 0 0 1 12 21 8.25 8.25 0 0 1 6.038 7.048 8.287 8.287 0 0 0 9 9.6a8.983 8.983 0 0 1 3.361-6.867 8.21 8.21 0 0 0 3 2.48z"/><path stroke-linecap="round" stroke-linejoin="round" d="M12 18a3.75 3.75 0 0 0 .495-7.468 5.99 5.99 0 0 0-1.925 3.547 5.975 5.975 0 0 1-2.133-1.001A3.75 3.75 0 0 0 12 18z"/></svg>
            </div>
            <h3>Berufsfeuerwehr</h3>
            <p>Berufsfeuerwehr: Feuerwehrdienstunfähigkeit, Beihilfe oder Heilfürsorge (je nach Land) und Einsatzschutz.</p>
          </a>
          <a class="card card--link" href="/bundespolizei.html">
            <div class="card__icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 0 1 1.04 0l2.125 5.111a.563.563 0 0 0 .475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 0 0-.182.557l1.285 5.385a.562.562 0 0 1-.84.61l-4.725-2.885a.562.562 0 0 0-.586 0L6.982 20.54a.562.562 0 0 1-.84-.61l1.285-5.386a.562.562 0 0 0-.182-.557l-4.204-3.602a.562.562 0 0 1 .321-.988l5.518-.442a.563.563 0 0 0 .475-.345L11.48 3.5z"/></svg>
            </div>
            <h3>Bundespolizei</h3>
            <p>Bundesbeamte im Vollzugsdienst: Heilfürsorge, Polizeidienstunfähigkeit, Grenz-, Bahn- und Luftsicherheit.</p>
          </a>
          <a class="card card--link" href="/zoll.html">
            <div class="card__icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path stroke-linecap="round" stroke-linejoin="round" d="M15 9h3.75M15 12h3.75M15 15h3.75M4.5 19.5h15a2.25 2.25 0 0 0 2.25-2.25V6.75A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25v10.5A2.25 2.25 0 0 0 4.5 19.5Zm6-10.125a1.875 1.875 0 1 1-3.75 0 1.875 1.875 0 0 1 3.75 0Zm1.294 6.336a6.721 6.721 0 0 1-3.17.789 6.721 6.721 0 0 1-3.168-.789 3.376 3.376 0 0 1 6.338 0Z"/></svg>
            </div>
            <h3>Zoll</h3>
            <p>Zollbeamtinnen &amp; Zollbeamte: Bundesbeamte mit Beihilfe, im Vollzugsdienst mit Einsatzrisiken.</p>
          </a>
          <a class="card card--link" href="/bundeswehr.html">
            <div class="card__icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.96 11.96 0 0 1 3.598 6 12 12 0 0 0 3 9.75c0 5.592 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.75a11.96 11.96 0 0 1-8.402-3.286Z"/></svg>
            </div>
            <h3>Bundeswehr</h3>
            <p>Soldatinnen und Soldaten: vom Dienstantritt bis zum Übergang ins zivile Leben.</p>
          </a>
          <a class="card card--link" href="/lehramt.html">
            <div class="card__icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.438 60.438 0 0 0-.491 6.347A48.62 48.62 0 0 1 12 20.904a48.62 48.62 0 0 1 8.232-4.41 60.46 60.46 0 0 0-.491-6.347m-15.482 0a50.636 50.636 0 0 0-2.658-.813A59.906 59.906 0 0 1 12 3.493a59.903 59.903 0 0 1 10.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.717 50.717 0 0 1 12 13.489a50.702 50.702 0 0 1 7.74-3.342M6.75 15a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm0 0v-3.675A55.378 55.378 0 0 1 12 8.443m-7.007 11.55A5.981 5.981 0 0 0 6.75 15.75v-1.5"/></svg>
            </div>
            <h3>Lehramt</h3>
            <p>Lehrkräfte &amp; Referendare: von der Diensthaftpflicht bis zur Verbeamtung.</p>
          </a>
          <a class="card card--link" href="/verwaltung.html">
            <div class="card__icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21a.75.75 0 0 1 .75.75V21"/></svg>
            </div>
            <h3>Verwaltung</h3>
            <p>Beamte &amp; Beschäftigte in Behörden und Kommunen, passend zu Ihrem Status.</p>
          </a>
          <a class="card card--link" href="/justiz.html">
            <div class="card__icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v17.25m0 0c-1.472 0-2.882.265-4.185.75M12 20.25c1.472 0 2.882.265 4.185.75M18.75 4.97A48.416 48.416 0 0 0 12 4.5c-2.291 0-4.545.16-6.75.47m13.5 0c1.01.143 2.01.317 3 .52m-3-.52 2.62 10.726c.122.499-.106 1.028-.589 1.202a5.988 5.988 0 0 1-2.031.352 5.988 5.988 0 0 1-2.031-.352c-.483-.174-.711-.703-.59-1.202L18.75 4.971Zm-16.5.52c.99-.203 1.99-.377 3-.52m0 0 2.62 10.726c.122.499-.106 1.028-.589 1.202a5.989 5.989 0 0 1-2.031.352 5.989 5.989 0 0 1-2.031-.352c-.483-.174-.711-.703-.59-1.202L5.25 4.971Z"/></svg>
            </div>
            <h3>Justiz</h3>
            <p>Richter, Staatsanwälte, Rechtspfleger &amp; Justizvollzug: Schutz mit Verantwortung.</p>
          </a>
          <a class="card card--link" href="/ordnungsamt.html">
            <div class="card__icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 0 0 2.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 0 0-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75 2.25 2.25 0 0 0-.1-.664m-5.8 0A2.251 2.251 0 0 1 13.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25Z"/></svg>
            </div>
            <h3>Ordnungsamt</h3>
            <p>Kommunaler Ordnungsdienst &amp; Außendienst: Haftung, Recht und Einkommen im Blick.</p>
          </a>
          <a class="card card--link" href="/sozial-erziehungsdienst.html">
            <div class="card__icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 0 0 3.741-.479 3 3 0 0 0-4.682-2.72m.94 3.198.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0 1 12 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 0 1 6 18.719m12 0a5.971 5.971 0 0 0-.941-3.197m0 0A5.995 5.995 0 0 0 12 12.75a5.995 5.995 0 0 0-5.058 2.772m0 0a3 3 0 0 0-4.681 2.72 8.986 8.986 0 0 0 3.74.477m.94-3.197a5.971 5.971 0 0 0-.94 3.197M15 6.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm6 3a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Zm-13.5 0a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Z"/></svg>
            </div>
            <h3>Sozial- &amp; Erziehungsdienst</h3>
            <p>Erzieher:innen &amp; Sozialarbeiter:innen: Arbeitskraft, Aufsichtspflicht und Vorsorge.</p>
          </a>
          <a class="card card--link" href="/kontakt.html">
            <div class="card__icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H8.25m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H12m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 0 1-2.555-.337A5.972 5.972 0 0 1 5.41 20.97a5.969 5.969 0 0 1-.474-.065 4.48 4.48 0 0 0 .978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25Z"/></svg>
            </div>
            <h3>Ihre Gruppe nicht dabei?</h3>
            <p>Kein Problem, sprechen Sie uns einfach an. Wir beraten alle Bereiche des Öffentlichen Dienstes.</p>
          </a>
        </div>
      </div>
    </section>
    <section class="section section--soft">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">Drei Wege im Öffentlichen Dienst</span>
          <h2>Welcher Status trifft auf Sie zu?</h2>
          <p>Ihre Absicherung hängt vor allem davon ab, ob Sie Beamter oder tarifbeschäftigt sind und ob Sie Beihilfe oder Heilfürsorge erhalten. Diese drei Gruppen unterscheiden wir:</p>
        </div>
        <div class="grid grid--3">
          <article class="card">
            <div class="card__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.96 11.96 0 0 1 3.598 6 12 12 0 0 0 3 9.75c0 5.592 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.75a11.96 11.96 0 0 1-8.402-3.286Z"/></svg></div>
            <h3>Beamte mit Beihilfe</h3>
            <p>Der Dienstherr übernimmt einen Teil der Krankheitskosten (Beihilfe), den Rest deckt eine private Krankenversicherung. Wichtige Themen: PKV zum Beihilfesatz, Dienstunfähigkeit und die Pensionslücke.</p>
          </article>
          <article class="card">
            <div class="card__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z"/></svg></div>
            <h3>Beamte mit Heilfürsorge</h3>
            <p>Im aktiven Dienst sind die Gesundheitskosten über die Heilfürsorge gedeckt (etwa bei Polizei oder Berufsfeuerwehr), im Ruhestand greift die Beihilfe. Eine PKV-Anwartschaft sichert den späteren Zugang zu guten Konditionen. Dazu die Dienstunfähigkeit.</p>
          </article>
          <article class="card">
            <div class="card__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z"/></svg></div>
            <h3>Tarifbeschäftigte (TVöD/TV-L)</h3>
            <p>Angestellte im Öffentlichen Dienst ohne Beihilfe, gesetzlich oder freiwillig privat versichert. Themen: Krankenversicherung, Berufsunfähigkeit, Altersvorsorge (Zusatzversorgung/VBL) und Sachversicherungen.</p>
          </article>
        </div>
        <div class="notice notice--info u-mt-l">
          <strong>Nicht sicher, wo Sie stehen?</strong> Kein Problem: Im Erstgespräch ordnen wir Ihren Status gemeinsam ein und schauen, was wirklich zu Ihnen passt.
        </div>
      </div>
    </section>
    <CtaBand eyebrow="Unsicher, was zu Ihnen passt?" href="/kontakt.html" label="Beratung anfragen">
<Fragment slot="title">Wir ordnen Ihre Situation gemeinsam ein</Fragment>
<p>Ein unverbindliches Erstgespräch zeigt schnell, wo Sie gut aufgestellt sind und wo es Lücken gibt.</p>
</CtaBand>
</Base>
