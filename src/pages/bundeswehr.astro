<Base title={"Versicherungen für Soldatinnen und Soldaten | Team-Neudorf"} description={"Absicherung für die Bundeswehr: truppenärztliche Versorgung ergänzen, Dienstunfähigkeit absichern, Übergang für Soldaten auf Zeit planen und vorsorgen."} path="/bundeswehr.html" jsonLd={jsonLd}>
