import CtaBand from '../components/CtaBand.astro';
import { Picture } from 'astro:assets';
import imgStefanPortrait from '../assets/images/stefan-portrait.jpg';
const jsonLd: unknown[] = [
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Start",
            "item": "https://www.team-neudorf.de/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Leistungen",
            "item": "https://www.team-neudorf.de/leistungen.html"
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": "Anwartschaftsversicherung",
            "item": "https://www.team-neudorf.de/anwartschaft.html"
          }
        ]
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Was ist eine Anwartschaftsversicherung?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Eine Anwartschaftsversicherung hält Ihnen den Platz in der privaten Krankenversicherung frei, solange Sie sie noch nicht brauchen. Ihr Gesundheitszustand wird beim Abschluss festgehalten. Wenn Sie die Versicherung später aktivieren, zählt dieser Stand. Erkrankungen aus der Zwischenzeit spielen dann keine Rolle mehr."
            }
          },
          {
            "@type": "Question",
            "name": "Wer braucht eine Anwartschaftsversicherung?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Vor allem Beamtinnen und Beamte mit Heilfürsorge oder truppenärztlicher Versorgung, etwa bei Polizei, Bundespolizei, Bundeswehr und je nach Bundesland bei Berufsfeuerwehr oder Justizvollzug. Spätestens im Ruhestand endet diese Versorgung, und dann brauchen Sie eine private Krankenversicherung zur Beihilfe. Sinnvoll ist sie auch, wenn Sie Ihre private Krankenversicherung vorübergehend nicht benötigen, zum Beispiel bei einem längeren Auslandsaufenthalt."
            }
          },
          {
            "@type": "Question",
            "name": "Was ist der Unterschied zwischen kleiner und großer Anwartschaft?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Die kleine Anwartschaft sichert Ihren Gesundheitszustand. Der spätere Beitrag richtet sich aber nach Ihrem dann erreichten Alter. Die große Anwartschaft sichert zusätzlich Ihr Eintrittsalter und baut Alterungsrückstellungen auf. Sie kostet in der Anwartschaftszeit mehr, dafür ist der Beitrag später spürbar niedriger, besonders im Ruhestand."
            }
          },
          {
            "@type": "Question",
            "name": "Was kostet eine Anwartschaftsversicherung?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Die kleine Anwartschaft kostet meist nur einen kleinen Teil des späteren vollen Beitrags. Die große Anwartschaft ist teurer, weil sie für das Alter vorsorgt. Die genaue Höhe hängt von Versicherer, Tarif, Alter und gewünschtem Umfang ab. Wir vergleichen das für Sie bei vielen Anbietern."
            }
          },
          {
            "@type": "Question",
            "name": "Wann sollte ich eine Anwartschaft abschließen?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "So früh wie möglich: am besten direkt zu Beginn Ihrer Dienstzeit, solange Sie jung und gesund sind. Beim Abschluss werden einmalig Gesundheitsfragen gestellt. Je gesünder Sie dann sind, desto besser sind die Bedingungen, die Sie sich für später sichern."
            }
          },
          {
            "@type": "Question",
            "name": "Muss ich für die Anwartschaft Gesundheitsfragen beantworten?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Ja, einmalig beim Abschluss. Diese Fragen sollten Sie sorgfältig und vollständig beantworten, damit Ihr Schutz später auch wirklich hält. Wir gehen die Fragen gemeinsam mit Ihnen durch. Danach gibt es beim Aktivieren der Versicherung keine neue Gesundheitsprüfung mehr."
            }
          }
        ]
      }
    ]
  }
