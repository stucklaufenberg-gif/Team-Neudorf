                <button role="tab" type="button" id={`r-tab-${i}`} aria-controls={`r-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-phase={i}><span class="roadmap__node" aria-hidden="true"></span><span class="label">{r.days}</span><strong>{r.title}</strong></button>
              ))}
            </div>
            {roadmap.map((r, i) => (
              <div class="roadmap__panel" role="tabpanel" id={`r-${i}`} aria-labelledby={`r-tab-${i}`} hidden={i !== 0}>
