---
// Digital Vision & Growth – interaktive Präsentation für Stefan Neudorf (Konzept für eine mögliche Zusammenarbeit).
import '@fontsource-variable/inter/wght.css';
import '@fontsource/instrument-serif/latin-400.css';
import '@fontsource/instrument-serif/latin-400-italic.css';
import '@fontsource/jetbrains-mono/latin-400.css';
import '@fontsource/jetbrains-mono/latin-500.css';
import '../styles/vision.css';
import { Image, Picture } from 'astro:assets';
import portrait from '../assets/portrait.jpg';
import avatar from '../assets/avatar.png';
import logo from '../assets/logo.png';
import adImg from '../assets/ad.jpg';
import reelA from '../assets/reel-a.jpg';
import reelB from '../assets/reel-b.jpg';
import reelC from '../assets/reel-c.jpg';
import reelD from '../assets/reel-d.jpg';
import reelE from '../assets/reel-e.jpg';
import { chapters, trustPoints, stations, system, positioning, stories, pillars, tiles, reels, compare, adVariants, campaign, journey, production, roles, roadmap, budget, questions } from '../data/vision';

const reelImg = { a: reelA, b: reelB, c: reelC, d: reelD, e: reelE } as const;
const ch = (id: string) => chapters.find((c) => c.id === id)!;
const words = (t: string) => t.split(' ');
const whoLabel = { gemeinsam: 'Gemeinsam', wir: 'Wir' } as const;
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Digital Vision & Growth · Stefan Neudorf</title>
    <meta name="description" content="Eine Vision für die digitale Personenmarke von Stefan Neudorf. Konzept für eine mögliche Zusammenarbeit." />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#011D37" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip" href="#start">Zum Inhalt springen</a>

    <!-- ========== Bedienelemente ========== -->
    <div class="progress" aria-hidden="true"><i data-progress></i></div>

    <header class="bar" data-chrome>
      <a class="bar__brand" href="#start" aria-label="Zum Anfang">
        <Image src={logo} alt="Team-Neudorf Versicherungen" width={300} densities={[1, 2]} loading="eager" />
      </a>
      <p class="bar__where" aria-live="polite"><span data-where-letter></span><span data-where-title>Digital Vision &amp; Growth</span></p>
      <div class="bar__actions">
        <button class="btn-ui" type="button" data-open-index aria-haspopup="dialog" aria-controls="index"><span class="btn-ui__icon" aria-hidden="true"></span>Kapitel</button>
        <button class="btn-ui btn-ui--gold" type="button" data-present aria-pressed="false">Präsentieren</button>
      </div>
    </header>

    <nav class="rail" data-chrome aria-label="Kapitel">
      <ol>
        {chapters.map((c) => (
          <li><a href={`#${c.id}`} data-rail={c.id} aria-label={`Kapitel ${c.letter}: ${c.title}`}><span>{c.letter}</span><em>{c.title}</em></a></li>
        ))}
      </ol>
    </nav>

    <div class="pager" aria-label="Schritt für Schritt">
      <button type="button" data-prev aria-label="Zurück (Pfeil links)">←</button>
      <span class="pager__count" aria-live="polite"><b data-stop-n>1</b> / <span data-stop-total>1</span></span>
      <button type="button" data-next aria-label="Weiter (Pfeil rechts)">→</button>
      <button type="button" class="pager__index" data-open-index aria-label="Kapitelübersicht öffnen (Taste G)">Übersicht</button>
      <button type="button" class="pager__exit" data-present-exit aria-label="Präsentationsmodus beenden (Esc)">Beenden</button>
    </div>

    <dialog class="index" id="index" aria-labelledby="index-title">
      <div class="index__inner">
        <header class="index__head">
          <p class="eyebrow">Kapitelübersicht</p>
          <h2 id="index-title">Digital Vision &amp; Growth</h2>
          <button class="btn-ui" type="button" data-close-index>Schließen</button>
        </header>
        <ol class="index__grid">
          {chapters.map((c) => (
            <li><a href={`#${c.id}`} data-index-link><span class="index__letter">{c.letter}</span><strong>{c.title}</strong><span>{c.line}</span></a></li>
          ))}
        </ol>
        <p class="index__keys"><kbd>←</kbd><kbd>→</kbd> Schritt zurück / weiter · <kbd>1</kbd>–<kbd>6</kbd> Kapitel · <kbd>G</kbd> Übersicht · <kbd>P</kbd> Präsentieren · <kbd>F</kbd> Vollbild · <kbd>Esc</kbd> Beenden</p>
      </div>
    </dialog>

    <main id="start">
      <!-- ========== HERO ========== -->
      <section class="hero" data-stop="Start" data-hero>
        <div class="hero__light" aria-hidden="true"><i></i><i></i><i></i></div>
        <canvas class="hero__dots" data-halftone aria-hidden="true"></canvas>
        <span class="hero__frame" aria-hidden="true"></span>
        <figure class="hero__portrait">
          <Picture src={portrait} alt="Stefan Neudorf, Versicherungsmakler in Mechernich" formats={['avif', 'webp']} widths={[480, 720, 900]} sizes="(max-width: 860px) 100vw, 46vw" loading="eager" fetchpriority="high" />
        </figure>
        <div class="hero__content wrap">
          <p class="eyebrow hero__eyebrow">Digital Vision &amp; Growth · für Stefan Neudorf</p>
          <h1 class="hero__title">
            <span class="line"><span>Aus einem Makler</span></span>
            <span class="line line--gold"><span><em>wird eine Marke.</em></span></span>
          </h1>
          <p class="hero__lead">Wie Stefan Neudorf digital sichtbar wird: persönlich, verständlich und messbar.</p>
          <div class="hero__actions">
            <a class="cta" href="#a">Vision ansehen</a>
            <button class="cta cta--ghost" type="button" data-open-index>Kapitelübersicht</button>
          </div>
        </div>
        <p class="hero__note wrap"><span>Konzept für eine mögliche Zusammenarbeit</span><span>November 2026</span><span class="hero__scroll" aria-hidden="true">Scrollen oder Pfeiltasten</span></p>
      </section>

      <!-- ========== A · DIE CHANCE ========== -->
      <section class="chapter" id="a" data-chapter="a">
        <header class="opener" data-stop="A · Die Chance" data-parallax>
          <span class="opener__letter" aria-hidden="true">A</span>
          <div class="wrap"><p class="eyebrow">Kapitel A</p><h2>{ch('a').title}</h2><p>{ch('a').line}</p></div>
        </header>

        <div class="scene scene--statement" data-scene>
          <i class="stop" data-stop="Vertrauen" style="top:88%"></i>
          <div class="scene__sticky">
            <div class="wrap">
              <p class="statement" data-words aria-label="Eine Versicherung kauft man nicht. Man vertraut einem Menschen.">
                {words('Eine Versicherung kauft man nicht.').map((w) => <span aria-hidden="true">{w} </span>)}
                {words('Man vertraut einem Menschen.').map((w) => <span class="gold" aria-hidden="true">{w} </span>)}
              </p>
            </div>
          </div>
        </div>

        <div class="block wrap" data-stop="Drei Gründe">
          <ol class="triple">
            {trustPoints.map((p, i) => (
              <li data-reveal style={`--i:${i}`}><span class="idx">0{i + 1}</span><h3>{p.title}</h3><p>{p.text}</p></li>
            ))}
          </ol>
        </div>

        <div class="block wrap ambassador" data-stop="Stefan selbst">
          <figure class="ambassador__figure" data-parallax data-reveal>
            <Picture src={portrait} alt="Porträt Stefan Neudorf" formats={['avif', 'webp']} widths={[480, 900]} sizes="(max-width: 900px) 80vw, 420px" loading="lazy" />
          </figure>
          <div>
            <p class="eyebrow" data-reveal>Der stärkste Markenbotschafter</p>
            <h2 class="h-xl" data-reveal>Die Geschichte muss niemand erfinden. <em>Sie ist schon da.</em></h2>
            <ol class="stations">
              {stations.map((s, i) => (
                <li data-reveal style={`--i:${i}`}><span class="label">{s.label}</span><div><h3>{s.title}</h3><p>{s.text}</p></div></li>
              ))}
            </ol>
            <blockquote data-reveal><p>„Den Öffentlichen Dienst kenne ich nicht nur aus der Theorie.“</p><footer>Stefan Neudorf auf team-neudorf.de</footer></blockquote>
          </div>
        </div>

        <div class="block wrap duo" data-stop="Website und Sichtbarkeit">
          <h2 class="h-xl" data-reveal>Eine gute Website wartet. <em>Sichtbarkeit geht zu den Menschen.</em></h2>
          <div class="duo__grid">
            <article class="duo__card" data-reveal>
              <p class="label">Website · das Fundament</p>
              <h3>Überzeugt, wer schon sucht</h3>
              <ul><li>Erklärt Leistungen und Berufsgruppen</li><li>Führt zum Kontakt</li><li>Steht bereit und ist nicht Teil dieses Angebots</li></ul>
            </article>
            <span class="duo__arrow" aria-hidden="true" data-reveal>→</span>
            <article class="duo__card duo__card--gold" data-reveal style="--i:1">
              <p class="label">Social Media · die Bewegung</p>
              <h3>Erreicht, wer noch nicht sucht</h3>
              <ul><li>Macht Stefan regelmäßig sichtbar</li><li>Baut Vertrauen auf, lange vor dem Bedarf</li><li>Bringt Besucher gezielt auf die Website</li></ul>
            </article>
          </div>
        </div>

        <div class="scene scene--system" data-scene>
          <i class="stop" data-stop="Das System" style="top:8%"></i>
          <i class="stop" data-stop="Das System: Ergebnis" style="top:92%"></i>
          <div class="scene__sticky">
            <div class="wrap">
              <p class="eyebrow">Die Chance</p>
              <h2 class="h-xl">Ein System statt <em>einzelner Beiträge.</em></h2>
              <ol class="chain" style={`--n:${system.length}`}>
                {system.map((s, i) => (
                  <li style={`--i:${i}`}><span class="chain__node" aria-hidden="true"></span><span class="idx">0{i + 1}</span><h3>{s.title}</h3><p>{s.text}</p></li>
                ))}
              </ol>
              <p class="aside">Am Ende steht nicht Reichweite, sondern das Beratungsgespräch.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- ========== B · DIE PERSONENMARKE ========== -->
      <section class="chapter" id="b" data-chapter="b">
        <header class="opener" data-stop="B · Die Personenmarke" data-parallax>
          <span class="opener__letter" aria-hidden="true">B</span>
          <div class="wrap"><p class="eyebrow">Kapitel B</p><h2>{ch('b').title}</h2><p>{ch('b').line}</p></div>
        </header>

        <div class="scene scene--statement" data-scene>
          <i class="stop" data-stop="Menschen folgen Menschen" style="top:88%"></i>
          <div class="scene__sticky">
            <div class="wrap statement-split">
              <p class="statement" data-words aria-label="Menschen folgen Menschen. Nicht Versicherungen.">
                {words('Menschen folgen Menschen.').map((w) => <span aria-hidden="true">{w} </span>)}
                {words('Nicht Versicherungen.').map((w) => <span class="gold" aria-hidden="true">{w} </span>)}
              </p>
              <figure class="statement__avatar"><Image src={avatar} alt="Stefan Neudorf" width={420} densities={[1, 2]} loading="lazy" /></figure>
            </div>
          </div>
        </div>

        <div class="block wrap" data-stop="Positionierung">
          <p class="lead-xl" data-reveal>Stefan soll nicht Versicherungen bewerben. Menschen sollen ihn kennenlernen, seiner Kompetenz vertrauen und im richtigen Moment an ihn denken.</p>
          <div class="axis" data-reveal>
            <span class="label">Nahbar</span>
            <div class="axis__line"><i></i><b><em>Stefan Neudorf</em></b></div>
            <span class="label">Professionell</span>
          </div>
        </div>

        <div class="block wrap" data-stop="Drei Felder">
          <h2 class="h-xl" data-reveal>Nahbar im Ton. <em>Präzise in der Sache.</em></h2>
          <div class="triple triple--fields">
            {positioning.map((p, i) => (
              <article data-reveal style={`--i:${i}`}><p class="label">{p.label}</p><h3>{p.title}</h3><ul>{p.items.map((t) => <li>{t}</li>)}</ul></article>
            ))}
          </div>
        </div>

        <div class="block wrap" data-stop="Vier Geschichten">
          <p class="eyebrow" data-reveal>Stoff für authentische Inhalte</p>
          <h2 class="h-xl" data-reveal>Vier Geschichten, die <em>nur Stefan</em> erzählen kann.</h2>
          <ol class="stories">
            {stories.map((s, i) => (
              <li data-reveal style={`--i:${i % 2}`}>
                <button type="button" class="story" aria-expanded="false" data-story>
                  <span class="idx">0{i + 1}</span>
                  <span class="story__title">{s.title}</span>
                  <span class="story__more" aria-hidden="true">+</span>
                  <span class="story__body"><span><b>Grundlage</b>{s.basis}</span><span><b>Erzählt</b>{s.tells}</span></span>
                </button>
              </li>
            ))}
          </ol>
          <p class="fine" data-reveal>Grundlage sind Stefans eigene Angaben auf team-neudorf.de. Erzählt wird nur, was er freigibt.</p>
        </div>
      </section>

      <!-- ========== C · SOCIAL-MEDIA-VISION ========== -->
      <section class="chapter" id="c" data-chapter="c">
        <header class="opener" data-stop="C · Die Social-Media-Vision" data-parallax>
          <span class="opener__letter" aria-hidden="true">C</span>
          <div class="wrap"><p class="eyebrow">Kapitel C</p><h2>{ch('c').title}</h2><p>{ch('c').line}</p></div>
        </header>

        <div class="block wrap profile" data-stop="Säulen und Profil" data-pillars>
          <div class="profile__text">
            <p class="eyebrow" data-reveal>Drei Content-Säulen</p>
            <h2 class="h-xl" data-reveal>So könnte Stefans Auftritt <em>aussehen.</em></h2>
            <div class="tabs" role="tablist" aria-label="Content-Säulen" data-reveal>
              {pillars.map((p, i) => (
                <button role="tab" type="button" id={`tab-${p.id}`} aria-controls={`panel-${p.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-pillar={p.id}><span class="idx">{p.n}</span>{p.title}</button>
              ))}
            </div>
            {pillars.map((p, i) => (
              <div class="tabpanel" role="tabpanel" id={`panel-${p.id}`} aria-labelledby={`tab-${p.id}`} hidden={i !== 0}>
                <p class="tabpanel__text">{p.text}</p>
                <ul class="formats">{p.formats.map((f) => <li>{f}</li>)}</ul>
                <p class="label label--gold">{p.effect}</p>
              </div>
            ))}
          </div>
          <div class="phone-stage" data-parallax data-tilt>
            <div class="phone" data-active-pillar="person">
              <p class="phone__handle">teamneudorf_versicherungen</p>
              <div class="phone__head">
                <Image src={avatar} alt="" width={140} densities={[1, 2]} loading="lazy" />
                <div><strong>Stefan Neudorf</strong><span>Versicherungsmakler</span><span>Privat · Gewerbe · Öffentlicher Dienst</span><span>Persönlich. Verständlich. Vor Ort.</span></div>
              </div>
              <div class="phone__buttons"><span class="is-gold">Folgen</span><span>Nachricht</span><span>Kontakt</span></div>
              <ul class="phone__highlights"><li>Über mich</li><li>ÖD</li><li>Fragen</li><li>Kontakt</li></ul>
              <ul class="phone__grid">
                {tiles.map((t) => (
                  <li data-tile={t.pillar}><Image src={reelImg[t.img]} alt="" width={240} loading="lazy" /><span>{t.text}</span></li>
                ))}
              </ul>
            </div>
            <p class="concept">Konzept · Visualisierung</p>
          </div>
        </div>

        <div class="block wrap reels" data-stop="Reel-Konzepte" data-reels>
          <p class="eyebrow" data-reveal>Vier Reels, die zu Stefan passen</p>
          <h2 class="h-xl" data-reveal>Ein Hook. Eine Aussage. <em>Ein nächster Schritt.</em></h2>
          <div class="reels__stage">
            <div class="reels__fan" role="tablist" aria-label="Reel-Konzepte" data-reveal>
              {reels.map((r, i) => (
                <button role="tab" type="button" class="reel-cover" id={`reel-tab-${r.id}`} aria-controls={`reel-${r.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-reel={r.id} style={`--k:${i}`}>
                  <Image src={reelImg[r.img]} alt="" width={420} loading="lazy" />
                  <span class="reel-cover__pillar">{r.pillar}</span>
                  <span class="reel-cover__title">{r.cover}</span>
                </button>
              ))}
            </div>
            <div class="reels__detail">
              {reels.map((r, i) => (
                <article role="tabpanel" id={`reel-${r.id}`} aria-labelledby={`reel-tab-${r.id}`} hidden={i !== 0}>
                  <p class="label label--gold">Reel 0{i + 1} · {r.length}</p>
                  <h3>„{r.hook}“</h3>
                  <dl>
                    <div><dt>Bild</dt><dd>{r.bild}</dd></div>
                    <div><dt>Kernaussage</dt><dd>{r.kern}</dd></div>
                    <div><dt>CTA</dt><dd>{r.cta}</dd></div>
                  </dl>
                </article>
              ))}
            </div>
          </div>
          <p class="fine"><span class="concept concept--inline">Konzept · Visualisierung</span> Fachliche Aussagen gibt Stefan vor jeder Veröffentlichung frei.</p>
        </div>

        <div class="block wrap boards" data-stop="Storyboard" data-boards>
          <p class="eyebrow" data-reveal>Exemplarisches Storyboard</p>
          <h2 class="h-xl" data-reveal>Fünf Einstellungen. <em>Ein Drehtermin.</em></h2>
          <div class="chips" data-reveal>
            <div class="chips__group" role="group" aria-label="Reel wählen">
              {reels.map((r, i) => <button type="button" aria-pressed={i === 0 ? 'true' : 'false'} data-board-btn={r.id}>Reel 0{i + 1}</button>)}
            </div>
          </div>
          {reels.map((r, i) => (
            <div data-board={r.id} hidden={i !== 0}>
              <p class="boards__hook">„{r.hook}“</p>
              <ol class="storyboard">
                {r.scenes.map((sc, j) => (
                  <li style={`--j:${j}`}><span class="storyboard__frame"><Image src={reelImg[r.img]} alt="" width={320} loading="lazy" /><b>0{j + 1}</b></span><span>{sc}</span></li>
                ))}
              </ol>
            </div>
          ))}
          <p class="fine"><span class="concept concept--inline">Konzept · Visualisierung</span> Die Bildausschnitte sind Platzhalter aus dem vorhandenen Porträt, keine gedrehten Szenen.</p>
        </div>
      </section>

      <!-- ========== D · DIGITAL GROWTH ========== -->
      <section class="chapter" id="d" data-chapter="d">
        <header class="opener" data-stop="D · Digital Growth" data-parallax>
          <span class="opener__letter" aria-hidden="true">D</span>
          <div class="wrap"><p class="eyebrow">Kapitel D</p><h2>{ch('d').title}</h2><p>{ch('d').line}</p></div>
        </header>

        <div class="block wrap" data-stop="Organisch und bezahlt" data-compare>
          <h2 class="h-xl" data-reveal>Organisch baut Vertrauen. <em>Bezahlt bringt Reichweite.</em></h2>
          <div class="switch" role="group" aria-label="Ansicht wählen" data-reveal>
            <button type="button" aria-pressed="true" data-mode="both">Beides</button>
            <button type="button" aria-pressed="false" data-mode="organic">Organisch</button>
            <button type="button" aria-pressed="false" data-mode="paid">Bezahlt</button>
          </div>
          <div class="compare" data-mode="both" data-reveal>
            <div class="compare__head"><span></span><h3 data-col="organic">Organischer Content</h3><h3 data-col="paid">Bezahlte Reichweite (Meta Ads)</h3></div>
            {compare.map((c) => (
              <div class="compare__row"><span class="label">{c.row}</span><p data-col="organic">{c.organic}</p><p data-col="paid">{c.paid}</p></div>
            ))}
          </div>
          <p class="aside" data-reveal>Was organisch funktioniert, bekommt Budget. Nicht umgekehrt.</p>
        </div>

        <div class="block wrap campaign" data-stop="Beispielkampagne" data-ad>
          <div class="ad-stage" data-parallax data-tilt>
            <article class="ad" data-format="feed">
              <header><Image src={avatar} alt="" width={64} densities={[1, 2]} loading="lazy" /><div><strong>teamneudorf_versicherungen</strong><span>Gesponsert</span></div></header>
              <div class="ad__media">
                <Image src={adImg} alt="Entwurf: Anzeigenmotiv mit Stefan Neudorf" width={640} loading="lazy" />
                <div class="ad__copy"><h3 data-ad-headline>{adVariants[0].headline}</h3><p data-ad-sub>{adVariants[0].sub}</p></div>
              </div>
              <footer><p data-ad-text>{adVariants[0].text}</p><span class="ad__cta" data-ad-cta>{adVariants[0].cta}</span></footer>
            </article>
            <p class="concept">Konzept · Visualisierung</p>
          </div>
          <div>
            <p class="eyebrow" data-reveal>Beispielkampagne</p>
            <h2 class="h-xl" data-reveal>Start ins <em>Referendariat.</em></h2>
            <div class="chips" data-reveal>
              <div class="chips__group" role="group" aria-label="Motiv">
                {adVariants.map((v, i) => <button type="button" aria-pressed={i === 0 ? 'true' : 'false'} data-ad-variant={v.id} data-headline={v.headline} data-sub={v.sub} data-text={v.text} data-cta={v.cta}>{v.label}</button>)}
              </div>
              <div class="chips__group" role="group" aria-label="Format">
                <button type="button" aria-pressed="true" data-ad-format="feed">Feed</button>
                <button type="button" aria-pressed="false" data-ad-format="story">Story</button>
              </div>
            </div>
            <dl class="facts">
              {campaign.map((c, i) => <div data-reveal style={`--i:${i}`}><dt>{c.label}</dt><dd>{c.text}</dd></div>)}
            </dl>
            <p class="fine" data-reveal>Für Finanz- und Versicherungswerbung können auf Meta besondere Regeln gelten. Zielgruppen und Plattformvorgaben prüfen wir gesondert, bevor eine Kampagne startet.</p>
          </div>
        </div>

        <div class="block wrap" data-stop="Customer Journey" data-journey>
          <p class="eyebrow" data-reveal>Von der Anzeige bis zur Anfrage</p>
          <h2 class="h-xl" data-reveal>Jeder Schritt bis zum Gespräch <em>ist sichtbar.</em></h2>
          <div class="journey" data-reveal style={`--n:${journey.length}`}>
            <div class="journey__line" aria-hidden="true"><i></i></div>
            <div class="journey__steps" role="tablist" aria-label="Customer Journey">
              {journey.map((j, i) => (
                <button role="tab" type="button" id={`j-tab-${i}`} aria-controls={`j-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-step={i}><span class="journey__node" aria-hidden="true"></span><span class="idx">0{i + 1}</span>{j.title}</button>
              ))}
            </div>
            {journey.map((j, i) => (
              <div class="journey__panel" role="tabpanel" id={`j-${i}`} aria-labelledby={`j-tab-${i}`} hidden={i !== 0}>
                <p class="journey__what">{j.what}</p>
                <dl><div><dt>Wir messen</dt><dd>{j.measure}</dd></div><div><dt>Quelle</dt><dd>{j.source}</dd></div></dl>
              </div>
            ))}
          </div>
          <p class="aside" data-reveal>Keine Prognosen: Nach 90 Tagen liegen echte Zahlen vor, und erst die entscheiden.</p>
        </div>
      </section>

      <!-- ========== E · PRODUKTION ========== -->
      <section class="chapter" id="e" data-chapter="e">
        <header class="opener" data-stop="E · Produktion & Automatisierung" data-parallax>
          <span class="opener__letter" aria-hidden="true">E</span>
          <div class="wrap"><p class="eyebrow">Kapitel E</p><h2>{ch('e').title}</h2><p>{ch('e').line}</p></div>
        </header>

        <div class="block wrap" data-stop="Der Ablauf" data-who>
          <h2 class="h-xl" data-reveal>Stefan berät. <em>Wir kümmern uns um den Rest.</em></h2>
          <div class="switch" role="group" aria-label="Zuständigkeit hervorheben" data-reveal>
            <button type="button" aria-pressed="true" data-who-filter="alle">Alle Schritte</button>
            <button type="button" aria-pressed="false" data-who-filter="gemeinsam">Mit Stefan</button>
            <button type="button" aria-pressed="false" data-who-filter="wir">Nur wir</button>
          </div>
          <ol class="process">
            {production.map((p, i) => (
              <li data-who-item={p.who} data-reveal style={`--i:${i % 3}`}><span class="process__n">0{i + 1}</span><h3>{p.title}</h3><p>{p.text}</p><span class:list={['label', p.who === 'wir' ? 'label--sky' : 'label--gold']}>{whoLabel[p.who]}</span></li>
            ))}
          </ol>
        </div>

        <div class="block wrap" data-stop="Rollen und Ausblick">
          <h2 class="h-xl" data-reveal>Wenig Aufwand für Stefan, <em>klare Aufgaben für uns.</em></h2>
          <div class="roles">
            <article data-reveal><p class="label label--gold">Stefans Anteil</p><ul>{roles.stefan.map((r) => <li>{r}</li>)}</ul></article>
            <article class="roles__wide" data-reveal style="--i:1"><p class="label label--gold">Unser Anteil, im vereinbarten Umfang</p><ul class="roles__two">{roles.wir.map((r) => <li>{r}</li>)}</ul></article>
          </div>
          <aside class="outlook" data-reveal>
            <p class="label">Ausblick · noch nicht vorhanden</p>
            <h3>Automatisierung als nächster Schritt</h3>
            <p>Themenvorschläge aus häufigen Kundenfragen, Varianten für verschiedene Formate, Auswertungen auf Knopfdruck. Sinnvoll, sobald der Rhythmus steht. Nichts davon läuft heute bereits.</p>
          </aside>
        </div>
      </section>

      <!-- ========== F · ZUSAMMENARBEIT ========== -->
      <section class="chapter" id="f" data-chapter="f">
        <header class="opener" data-stop="F · Zusammenarbeit" data-parallax>
          <span class="opener__letter" aria-hidden="true">F</span>
          <div class="wrap"><p class="eyebrow">Kapitel F</p><h2>{ch('f').title}</h2><p>{ch('f').line}</p></div>
        </header>

        <div class="block wrap" data-stop="90-Tage-Pilot" data-roadmap>
          <p class="eyebrow" data-reveal>Vorschlag für den Einstieg</p>
          <h2 class="h-xl" data-reveal>90 Tage, um es <em>gemeinsam herauszufinden.</em></h2>
          <div class="roadmap" data-reveal data-active="0" style={`--n:${roadmap.length}`}>
            <div class="roadmap__track" aria-hidden="true"><i></i></div>
            <div class="roadmap__steps" role="tablist" aria-label="Pilotphase">
              {roadmap.map((r, i) => (
                <button role="tab" type="button" id={`r-tab-${i}`} aria-controls={`r-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-phase={i}><span class="roadmap__node" aria-hidden="true"></span><span class="label">{r.days}</span><strong>{r.title}</strong></button>
              ))}
            </div>
            {roadmap.map((r, i) => (
              <div class="roadmap__panel" role="tabpanel" id={`r-${i}`} aria-labelledby={`r-tab-${i}`} hidden={i !== 0}>
                <ul>{r.items.map((t) => <li>{t}</li>)}</ul>
                <p>{r.result}</p>
              </div>
            ))}
          </div>
        </div>

        <div class="block wrap" data-stop="Zwei getrennte Posten">
          <h2 class="h-xl" data-reveal>Zwei getrennte Posten, <em>volle Kontrolle.</em></h2>
          <div class="budget">
            {budget.map((b, i) => (
              <article data-reveal style={`--i:${i}`} class:list={[{ 'is-gold': i === 1 }]}><p class="label label--gold">{b.label}</p><h3>{b.title}</h3><ul>{b.items.map((t) => <li>{t}</li>)}</ul><p class="budget__foot">{b.foot}</p></article>
            ))}
          </div>
          <p class="fine" data-reveal>Preise nennen wir im Gespräch. Es gibt keine garantierten Ergebnisse: Wir zeigen, was wir tun und was es bringt.</p>
        </div>

        <div class="closing" data-stop="Der nächste Schritt">
          <canvas class="closing__dots" data-halftone aria-hidden="true"></canvas>
          <div class="wrap closing__grid">
            <div>
              <p class="eyebrow" data-reveal>Der nächste Schritt</p>
              <h2 class="closing__title" data-reveal>Kein Vertrag. <em>Ein Gespräch.</em></h2>
              <ol class="questions">
                {questions.map((q, i) => <li data-reveal style={`--i:${i}`}><span class="idx">0{i + 1}</span>{q}</li>)}
              </ol>
              <div class="hero__actions" data-reveal><a class="cta cta--ghost" href="#start">Zurück zum Anfang</a><button class="cta cta--ghost" type="button" data-open-index>Kapitelübersicht</button></div>
            </div>
            <figure class="closing__avatar" data-parallax data-reveal><Image src={avatar} alt="Stefan Neudorf" width={420} densities={[1, 2]} loading="lazy" /></figure>
          </div>
          <p class="wrap closing__legal">Konzept für eine mögliche Zusammenarbeit. Alle Mockups sind Visualisierungen ohne echte Reichweiten-, Follower- oder Ergebniszahlen. Angaben zu Stefan Neudorf stammen von team-neudorf.de und seinem Instagram-Profil.</p>
        </div>
      </section>
    </main>

    <script>
      import '../scripts/vision.ts';
    </script>
  </body>
</html>
