---
// Digital Vision & Growth – interaktiver Agentur-Pitch für Stefan Neudorf (Konzept für eine mögliche Zusammenarbeit).
import '@fontsource-variable/inter/wght.css';
import '@fontsource/instrument-serif/latin-400.css';
import '@fontsource/instrument-serif/latin-400-italic.css';
import '@fontsource/jetbrains-mono/latin-400.css';
import '@fontsource/jetbrains-mono/latin-500.css';
import '../styles/vision.css';
import { Image, Picture } from 'astro:assets';
import SceneArt from '../components/SceneArt.astro';
import { existsSync } from 'node:fs';
import portrait from '../assets/portrait.jpg';
import avatar from '../assets/avatar.png';
import logo from '../assets/logo.png';
import adImg from '../assets/ad.jpg';
import reelA from '../assets/reel-a.jpg';
import reelB from '../assets/reel-b.jpg';
import reelC from '../assets/reel-c.jpg';
import reelD from '../assets/reel-d.jpg';
import reelE from '../assets/reel-e.jpg';
import {
  chapters, tagLabel, brands, potentialTakeaways, pillarsOfPitch, mechanicRefs, observations, hookFacts, hookLayers, hookTopic, hookVariants, calTypes, calTypeName, days, calendar, campaigns, adRules, pathNodes, routes, levels, workflows, dashData, kpiSources, roadmap, costTypes, questions, aiChain, aiPrinciples, reels, reelRoles, brandPhases, effort, reuseTopics, reuseOutputs, reuseAssets,
} from '../data/vision';

const img = { a: reelA, b: reelB, c: reelC, d: reelD, e: reelE, ad: adImg } as const;
const levelName = Object.fromEntries(levels.map((l) => [l.id, l.label]));
const firstCal = calendar[0].items[0];
const calCount = calendar.reduce((n, w) => n + w.items.length, 0);
const d0 = dashData[0];
const c0 = campaigns[0];
// Reel-Slots: Ein Video erscheint nur, wenn die Datei beim Build in public/media/reels/ liegt. Sonst zeigt der Slot das Storyboard.
const media = (f: string) => existsSync(`public/media/reels/${f}`) ? `/media/reels/${f}` : '';
const reelMedia = reels.map((r) => ({ video: media(`${r.file}.mp4`), poster: media(`${r.file}.jpg`) }));
const whoName = { wir: 'Agentur', stefan: 'Stefan' } as const;
// Build-Kennung: zeigt online, aus welchem Commit diese Fassung gebaut wurde.
// Netlify setzt COMMIT_REF, Cloudflare Workers Builds WORKERS_CI_COMMIT_SHA. Lokal steht dort „lokal“.
declare const process: { env: Record<string, string | undefined> };
const buildCommit = (process.env.COMMIT_REF || process.env.WORKERS_CI_COMMIT_SHA || 'lokal').slice(0, 7);
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Digital Vision & Growth · Stefan Neudorf</title>
    <meta name="description" content="Unsere Vision für Stefans digitales Wachstum: KI-Content, sechs Reel-Beispiele und eine starke Personal Brand." />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href="https://team-neudorf-digital-vision.netlify.app/" />
    <!-- Linkvorschau (WhatsApp, Facebook, LinkedIn, X): statisch im HTML, ohne JavaScript. Neuer Bildname = neuer Vorschau-Cache. -->
    <meta property="og:title" content="Digital Vision & Growth | Team Neudorf" />
    <meta property="og:description" content="Unsere Vision für Stefans digitales Wachstum: KI-Content, sechs Reel-Beispiele und eine starke Personal Brand." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://team-neudorf-digital-vision.netlify.app/" />
    <meta property="og:image" content="https://team-neudorf-digital-vision.netlify.app/og/digital-vision-share-2026-11-20.jpg" />
    <meta property="og:image:secure_url" content="https://team-neudorf-digital-vision.netlify.app/og/digital-vision-share-2026-11-20.jpg" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Team-Neudorf Digital Vision & Growth" />
    <meta property="og:site_name" content="Team Neudorf" />
    <meta property="og:locale" content="de_DE" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Digital Vision & Growth | Team Neudorf" />
    <meta name="twitter:description" content="Unsere Vision für Stefans digitales Wachstum: KI-Content, sechs Reel-Beispiele und eine starke Personal Brand." />
    <meta name="twitter:image" content="https://team-neudorf-digital-vision.netlify.app/og/digital-vision-share-2026-11-20.jpg" />
    <meta name="twitter:image:alt" content="Team-Neudorf Digital Vision & Growth" />
    <meta name="dv-build" content={buildCommit} />
    <meta name="theme-color" content="#011D37" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip" href="#start">Zum Inhalt springen</a>

    <!-- ========== Bedienelemente ========== -->
    <div class="progress" aria-hidden="true"><i data-progress></i></div>

    <header class="bar" data-chrome>
      <a class="bar__brand" href="#start" aria-label="Zum Anfang">
        <Image src={logo} alt="Team-Neudorf Versicherungen" width={300} densities={[1, 2]} loading="eager" />
      </a>
      <p class="bar__where" aria-live="polite"><span data-where-letter></span><span data-where-title>Digital Vision &amp; Growth</span></p>
      <div class="bar__actions">
        <button class="btn-ui" type="button" data-open-index aria-haspopup="dialog" aria-controls="index"><span class="btn-ui__icon" aria-hidden="true"></span>Kapitel</button>
        <button class="btn-ui btn-ui--gold" type="button" data-present aria-pressed="false">Präsentieren</button>
      </div>
    </header>

    <nav class="rail" data-chrome aria-label="Kapitel">
      <ol>
        {chapters.map((c) => (
          <li><a href={`#${c.id}`} data-rail={c.id} aria-label={`Kapitel ${c.n}: ${c.title}`}><span>{c.n}</span><em>{c.title}</em></a></li>
        ))}
      </ol>
    </nav>

    <div class="pager" aria-label="Schritt für Schritt">
      <button type="button" data-prev aria-label="Zurück (Pfeil links)">←</button>
      <span class="pager__count" aria-live="polite"><b data-stop-n>1</b> / <span data-stop-total>1</span></span>
      <button type="button" data-next aria-label="Weiter (Pfeil rechts)">→</button>
      <button type="button" class="pager__index" data-open-index aria-label="Kapitelübersicht öffnen (Taste G)">Übersicht</button>
      <button type="button" class="pager__exit" data-present-exit aria-label="Präsentationsmodus beenden (Esc)">Beenden</button>
    </div>

    <dialog class="index" id="index" aria-labelledby="index-title">
      <div class="index__inner">
        <header class="index__head">
          <p class="eyebrow">Kapitelübersicht</p>
          <h2 id="index-title">Digital Vision &amp; Growth</h2>
          <button class="btn-ui" type="button" data-close-index>Schließen</button>
        </header>
        <ol class="index__grid">
          {chapters.map((c) => (
            <li><a href={`#${c.id}`} data-index-link><span class="index__letter">{c.n}</span><strong>{c.title}</strong><span>{c.line}</span></a></li>
          ))}
        </ol>
        <p class="index__keys"><kbd>←</kbd><kbd>→</kbd> Schritt zurück / weiter · <kbd>1</kbd>–<kbd>9</kbd>, <kbd>0</kbd> Station 01–10 · <kbd>G</kbd> Übersicht · <kbd>P</kbd> Präsentieren · <kbd>F</kbd> Vollbild · <kbd>Esc</kbd> Beenden</p>
      </div>
    </dialog>

    <main id="start">
      <!-- ========== 01 · EINSTIEG ========== -->
      <section class="hero chapter" id="s1" data-chapter="s1" data-stop="01 · Einstieg" data-hero>
        <div class="hero__light" aria-hidden="true"><i></i><i></i><i></i></div>
        <canvas class="hero__dots" data-halftone aria-hidden="true"></canvas>
        <span class="hero__frame" aria-hidden="true"></span>
        <figure class="hero__portrait">
          <Picture src={portrait} alt="Stefan Neudorf, Versicherungsmakler in Mechernich" formats={['avif', 'webp']} widths={[480, 720, 900]} sizes="(max-width: 860px) 100vw, 46vw" loading="eager" fetchpriority="high" />
        </figure>
        <div class="hero__content wrap">
          <p class="eyebrow hero__eyebrow">Digital Growth Pitch · für Stefan Neudorf</p>
          <h1 class="hero__title hero__title--long">
            <span class="line"><span>Deine Expertise</span></span>
            <span class="line"><span>verdient mehr</span></span>
            <span class="line line--gold"><span><em>Sichtbarkeit.</em></span></span>
          </h1>
          <p class="hero__lead">Wir starten dein Marketing, bevor du vor einer Kamera stehen musst. Und bauen parallel deine Expertenmarke auf: von der Content-Idee bis zur qualifizierten Beratungsanfrage.</p>
          <div class="hero__actions">
            <a class="cta" href="#s2">Pitch starten</a>
            <button class="cta cta--ghost" type="button" data-open-index>Alle 15 Stationen</button>
          </div>
        </div>
        <p class="hero__note wrap"><span>Konzept für eine mögliche Zusammenarbeit</span><span>November 2026</span></p>
      </section>

      <!-- ========== 02 · MARKTPOTENZIAL ========== -->
      <section class="chapter block wrap" id="s2" data-chapter="s2" data-stop="02 · Marktpotenzial">
        <p class="eyebrow" data-reveal>02 · Marktpotenzial</p>
        <h2 class="h-xl" data-reveal>Versicherungswissen <em>hat ein Publikum.</em></h2>
        <div class="market">
          <ul class="brands">
            {brands.map((b, i) => (
              <li data-reveal style={`--i:${i}`}>
                <span class="label">{b.platform} · {b.focus}</span>
                <strong>{b.name}</strong>
                <span class="brands__handle">@{b.handle}</span>
                <b class:list={['brands__reach', { 'is-open': b.date === 'unklar' }]}>{b.reach}</b>
                <small>Follower · Stand {b.date} · <a href={b.source} target="_blank" rel="noopener noreferrer">{b.sourceLabel}</a></small>
              </li>
            ))}
          </ul>
          <aside class="market__side" data-reveal style="--i:2">
            <p class="label label--gold">Was wir daraus ableiten</p>
            <ul class="takeaways">{potentialTakeaways.map((t) => <li>{t}</li>)}</ul>
          </aside>
        </div>
        <p class="fine" data-reveal><span class="tag tag--quelle">{tagLabel.quelle}</span> Alle Werte aus <a href="https://www.versicherungenmitkopf.de/allgemein/die-besten-versicherungs-instagrammer-deutschlands" target="_blank" rel="noopener noreferrer">„Die besten Versicherungs-Instagrammer Deutschlands 2026“</a> eines Maklerunternehmens, ein einheitlicher Erhebungsstand: 20.10.2026, gerundete Instagram-Anzeige. Im Original geprüft am 20.11.2026. Über Anfragen oder Abschlüsse dieser Accounts ist nichts bekannt.</p>
      </section>

      <!-- ========== 03 · DIFFERENZIERUNG ========== -->
      <section class="chapter block wrap" id="s3" data-chapter="s3" data-stop="03 · Unsere Differenzierung">
        <p class="eyebrow" data-reveal>03 · Unsere Differenzierung</p>
        <h2 class="h-xl" data-reveal>Vier Kompetenzen. <em>Ein Team.</em></h2>
        <div class="quad" data-reveal>
          {pillarsOfPitch.map((p, i) => (
            <article style={`--i:${i}`}><span class="idx">0{i + 1}</span><h3>{p.title}</h3><p>{p.text}</p></article>
          ))}
          <figure class="quad__center"><Image src={avatar} alt="Stefan Neudorf" width={220} densities={[1, 2]} loading="lazy" /><figcaption>Stefan als Gesicht der Marke</figcaption></figure>
        </div>
        <div class="obs" data-reveal>
          <p class="label label--gold">Beobachtete Creator-Mechanik → unser Format</p>
          <ol>
            {observations.map((o) => <li><span class="idx">{o.time}</span><span class="obs__seen">{o.seen}</span><span class="obs__ours">{o.ours}</span></li>)}
          </ol>
          <p class="fine"><span class="tag tag--quelle">Beobachtung</span> Qualitative Sichtung einer bereitgestellten Bildschirmaufnahme von Creator-Class-Inhalten auf Instagram (20.11.2026). Kein Ranking, keine Views, keine Performance-Aussage; gesprochene Hooks wurden nicht transkribiert. Referenzen: {mechanicRefs.map((r, i) => <>{i > 0 && ', '}<a href={r.url} target="_blank" rel="noopener noreferrer">{r.name}</a></>)}, jeweils nur für Content-Mechanik.</p>
        </div>
      </section>

      <!-- ========== 04 · KI-FIRST ========== -->
      <section class="chapter block wrap" id="s4" data-chapter="s4" data-stop="04 · KI-first" data-aichain>
        <p class="eyebrow" data-reveal>04 · KI-first</p>
        <h2 class="h-xl" data-reveal>Dein Marketing kann starten, <em>bevor dein erster Drehtag stattfindet.</em></h2>
        <div class="chain8" data-reveal style="--a:0">
          <div class="chain8__track" aria-hidden="true"><i></i></div>
          <div class="chain8__steps" role="tablist" aria-label="Produktionskette">
            {aiChain.map((c, i) => (
              <button role="tab" type="button" id={`ai-tab-${i}`} aria-controls={`ai-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-who={c.who}><span class="chain8__dot" aria-hidden="true"></span><span class="idx">{c.n}</span><strong>{c.title}</strong></button>
            ))}
          </div>
          {aiChain.map((c, i) => (
            <div class="chain8__panel" role="tabpanel" id={`ai-${i}`} aria-labelledby={`ai-tab-${i}`} hidden={i !== 0}>
              <p class="chain8__text">{c.text}</p>
              <dl>
                <div><dt>Werkzeug</dt><dd>{c.tool}</dd></div>
                <div><dt>Ergebnis</dt><dd>{c.out}</dd></div>
                <div><dt>Wer</dt><dd class={`who who--${c.who}`}>{whoName[c.who]}</dd></div>
              </dl>
            </div>
          ))}
        </div>
        <ul class="principles" data-reveal>
          {aiPrinciples.map((p, i) => <li style={`--i:${i}`}><span class="label label--gold">{p.role}</span><strong>{p.title}</strong><span>{p.text}</span></li>)}
        </ul>
        <p class="fine" data-reveal><span class="tag tag--idee">Unser Produktionssystem</span> So würden wir für Team-Neudorf produzieren. Nichts davon ist bereits eingerichtet, und nichts wird ohne Stefans fachliche Freigabe veröffentlicht.</p>
      </section>

      <!-- ========== 05 · CONTENT-LAB ========== -->
      <section class="chapter block wrap" id="s5" data-chapter="s5" data-stop="05 · Das Content-Lab" data-hooklab>
        <p class="eyebrow" data-reveal>05 · Das Content-Lab</p>
        <h2 class="h-xl" data-reveal>Drei Hooks in <em>drei Sekunden.</em></h2>
        <div class="lab">
          <div class="lab__controls" data-reveal>
            <p class="lab__topic"><span class="label">Thema</span>{hookTopic}</p>
            <div class="tabs lab__variants" role="tablist" aria-label="Hook-Varianten">
              {hookVariants.map((v, i) => (
                <button role="tab" type="button" id={`hv-tab-${v.id}`} aria-controls={`hv-${v.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-variant={v.id}>{v.label}</button>
              ))}
            </div>
            <div class="lab__layers" role="group" aria-label="Ebenen ein- und ausblenden">
              {hookLayers.map((l) => <button type="button" aria-pressed="true" data-layer={l.id}><i aria-hidden="true"></i>{l.label}<small>{l.short}</small></button>)}
            </div>
          </div>
          <div class="lab__phone" data-reveal style="--i:1">
            <div class="reelphone" data-lab-phone data-layers="visual spoken text">
              {hookVariants.map((v, i) => (
                <div class="reelphone__screen" data-lab-screen={v.id} hidden={i !== 0}>
                  <div class="reelphone__visual"><SceneArt scene={v.scene} /></div>
                  <p class="reelphone__text">{v.text}</p>
                  <p class="reelphone__spoken"><span aria-hidden="true">◖◗</span>{v.spoken}</p>
                </div>
              ))}
              <span class="reelphone__ui" aria-hidden="true"><i></i><i></i><i></i></span>
            </div>
            <p class="concept">Konzept · gezeichnete Szene</p>
          </div>
          <div class="lab__detail" data-reveal style="--i:2">
            {hookVariants.map((v, i) => (
              <dl role="tabpanel" id={`hv-${v.id}`} aria-labelledby={`hv-tab-${v.id}`} hidden={i !== 0}>
                <div data-layer-row="visual"><dt>Visual</dt><dd>{v.visual}</dd></div>
                <div data-layer-row="spoken"><dt>Spoken</dt><dd>{v.spoken}</dd></div>
                <div data-layer-row="text"><dt>Text</dt><dd>{v.text}</dd></div>
                <div><dt>CTA</dt><dd>{v.cta}</dd></div>
                <div class="lab__why"><dt>Warum</dt><dd>{v.why}</dd></div>
              </dl>
            ))}
          </div>
        </div>
        <ul class="facts-mini" data-reveal>
          {hookFacts.map((f) => <li><span class="tag tag--doku">{tagLabel.doku}</span>{f.text} <a href={f.url} target="_blank" rel="noopener noreferrer">{f.source}</a></li>)}
          <li><span class="tag tag--quelle">Beobachtung</span>In der gesichteten Creator-Aufnahme arbeiten die Formate mit Bild, kurzem Text und Sprecher gleichzeitig. Die drei Varianten oben sind unser eigenes Formatkonzept. Welche besser wirkt, zeigt erst der Test.</li>
        </ul>
      </section>

      <!-- ========== 06 · SECHS MUSTER-REELS ========== -->
      <section class="chapter block wrap" id="s6" data-chapter="s6" data-stop="06 · Sechs Muster-Reels" data-gallery>
        <p class="eyebrow" data-reveal>06 · Sechs Muster-Reels</p>
        <h2 class="h-xl" data-reveal>Sechs Themen. Sechs Formate. <em>Ein Content-System.</em></h2>
        <div class="gallery">
          <div class="gallery__list" role="tablist" aria-label="Muster-Reels" data-reveal>
            {reels.map((r, i) => (
              <button role="tab" type="button" id={`rg-tab-${r.id}`} aria-controls={`rg-${r.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-reel={r.id}>
                <span class="idx">Reel {r.n}</span><strong>{r.title}</strong><span class="gallery__role">{reelRoles[r.role]}</span>
                <span class:list={['gallery__state', { 'is-video': !!reelMedia[i].video }]}>{reelMedia[i].video ? 'Film' : 'Storyboard'}</span>
              </button>
            ))}
          </div>
          <div class="gallery__stage" data-reveal style="--i:1">
            {reels.map((r, i) => (
              <div class="gallery__slot" data-slot={r.id} hidden={i !== 0}>
                <div class:list={['reelphone reelphone--xl', { 'has-video': !!reelMedia[i].video }]} data-reel-player>
                  <div class="reelphone__screen">
                    <div class="reelphone__visual">
                      <SceneArt scene={r.scene} />
                      {reelMedia[i].video && <video src={reelMedia[i].video} poster={reelMedia[i].poster || undefined} muted playsinline preload="none" data-reel-video></video>}
                    </div>
                    <p class="reelphone__text">{r.hook}</p>
                    {reelMedia[i].video ? (
                      <>
                        <button type="button" class="reelphone__play" data-reel-play aria-label={`Muster-Reel „${r.title}“ abspielen`}><span aria-hidden="true"></span></button>
                        <button type="button" class="reelphone__sound" data-reel-sound aria-pressed="false">Ton an</button>
                      </>
                    ) : <span class="reelphone__badge">Storyboard · Film folgt</span>}
                  </div>
                  <span class="reelphone__ui" aria-hidden="true"><i></i><i></i><i></i></span>
                </div>
                <p class="concept">KI-gestützte Musterproduktion · unveröffentlicht</p>
              </div>
            ))}
          </div>
          <div class="gallery__detail" data-reveal style="--i:2">
            {reels.map((r, i) => (
              <article role="tabpanel" id={`rg-${r.id}`} aria-labelledby={`rg-tab-${r.id}`} hidden={i !== 0}>
                <p class="label label--gold">Reel {r.n} · {r.status}</p>
                <h3>{r.title}</h3>
                <dl class="gallery__facts">
                  <div><dt>Zielgruppe</dt><dd>{r.audience}</dd></div>
                  <div><dt>Mechanik</dt><dd>{r.mechanic}</dd></div>
                  <div><dt>Visual Hook</dt><dd>{r.visual}</dd></div>
                  <div><dt>Text Hook</dt><dd>„{r.hook}“</dd></div>
                  <div><dt>Fachthema</dt><dd>{r.topic}</dd></div>
                  <div><dt>Ziel</dt><dd>{r.goal} · {reelRoles[r.role]}</dd></div>
                </dl>
                <ol class="gallery__board">
                  {r.board.map(([t, b]) => <li><span class="idx">{t}</span>{b}</li>)}
                </ol>
              </article>
            ))}
          </div>
        </div>
        <p class="fine" data-reveal><span class="concept concept--inline">KI-gestützte Musterproduktion · 9:16 · ohne Voice-over</span> Noch nicht veröffentlicht. Die Versicherungs- und Rechtsaussagen in den Filmen müssen vor einer Veröffentlichung von Stefan fachlich freigegeben werden.</p>
      </section>

      <!-- ========== 07 · PERSONAL BRAND ========== -->
      <section class="chapter block wrap" id="s7" data-chapter="s7" data-stop="07 · Personal Brand" data-brand>
        <p class="eyebrow" data-reveal>07 · Die Personal Brand wächst mit</p>
        <h2 class="h-xl" data-reveal>Sofort sichtbar werden. <em>Schritt für Schritt unverwechselbar werden.</em></h2>
        <div class="brandmap" data-reveal>
          <div class="brandmap__tabs" role="tablist" aria-label="Phasen">
            {brandPhases.map((p, i) => <button role="tab" type="button" id={`bp-tab-${p.id}`} aria-controls={`bp-${p.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-ai={p.ai}><span class="idx">{p.tab}</span><strong>{p.title}</strong></button>)}
          </div>
          <div class="brandmap__mix" style={`--ai:${brandPhases[0].ai}`} aria-hidden="true">
            <span class="brandmap__ai">KI-Content</span><span class="brandmap__you">Deine Aufnahmen</span>
          </div>
          <p class="brandmap__legend">Anteile illustrativ, keine Quote</p>
          {brandPhases.map((p, i) => (
            <div class="brandmap__panel" role="tabpanel" id={`bp-${p.id}`} aria-labelledby={`bp-tab-${p.id}`} hidden={i !== 0}>
              <p class="brandmap__text">{p.text}</p>
              <div><p class="label label--gold">Dein Anteil</p><ul>{p.stefan.map((t) => <li>{t}</li>)}</ul></div>
              <p class="brandmap__out">{p.output}</p>
            </div>
          ))}
        </div>
        <p class="aside" data-reveal>Du musst nicht über Nacht zum Creator werden. Deine Präsenz wächst planbar mit.</p>
      </section>

      <!-- ========== 08 · EINE QUELLE, VIELE INHALTE ========== -->
      <section class="chapter block wrap" id="s8" data-chapter="s8" data-stop="08 · Eine Quelle, viele Inhalte" data-shoot>
        <p class="eyebrow" data-reveal>08 · Eine Quelle, viele Inhalte</p>
        <h2 class="h-xl" data-reveal>Eine Checkliste. <em>Content für Wochen.</em></h2>
        <div class="shoot" data-reveal>
          <div class="shoot__source">
            <div class="shoot__cam shoot__cam--doc"><SceneArt scene="detail" /><span class="shoot__rec shoot__rec--doc" aria-hidden="true">NRW-Checkliste</span></div>
            <label class="shoot__range" for="shoot-n"><span class="label">Themen aus der Checkliste</span><output for="shoot-n" data-shoot-n>6</output></label>
            <input id="shoot-n" type="range" min="3" max="8" step="1" value="6" data-shoot-input />
            <ul class="shoot__topics" aria-label="Themen">
              {reuseTopics.map((t, i) => <li data-topic={i}>{t}</li>)}
            </ul>
          </div>
          <span class="shoot__arrow" aria-hidden="true">→</span>
          <div class="shoot__out" aria-live="polite">
            <ul class="shoot__tiles shoot__tiles--6">
              {reuseOutputs.map((o) => (
                <li><span class={`shape shape--${o.shape}`} aria-hidden="true"><i></i><i></i><i></i></span><b data-out={o.id}>0</b><span class="shoot__label">{o.label}</span><small>{o.hint}</small></li>
              ))}
            </ul>
            <div class="shoot__weeks">
              <p><b data-out="feed">0</b> Feed-Beiträge. Bei drei pro Woche reicht das für rund <b data-out="weeks">0</b> Wochen.</p>
              <ol aria-hidden="true">{[1, 2, 3, 4, 5, 6].map((w) => <li data-week={w}>W{w}</li>)}</ol>
            </div>
            <p class="reuse"><span class="label">Wiederverwendet</span>{reuseAssets.map((a) => <span>{a}</span>)}</p>
          </div>
        </div>
        <p class="fine" data-reveal><span class="concept concept--inline">Illustratives Rechenbeispiel · keine Zusage</span> Menge und Rhythmus legen wir im Leistungspaket fest. Veröffentlicht wird nur nach Freigabe.</p>
      </section>

      <!-- ========== 09 · VIER WOCHEN CONTENT ========== -->
      <section class="chapter block wrap" id="s9" data-chapter="s9" data-stop="09 · Vier Wochen Content" data-cal>
        <p class="eyebrow" data-reveal>09 · Vier Wochen Content</p>
        <h2 class="h-xl" data-reveal>Jede Woche führt <em>zur Checkliste oder zu dir.</em></h2>
        <div class="chips" data-reveal>
          <div class="chips__group" role="group" aria-label="Nach Art filtern">
            <button type="button" aria-pressed="true" data-cal-filter="alle">Alle</button>
            {calTypes.map((t) => <button type="button" aria-pressed="false" data-cal-filter={t.id}>{t.label}</button>)}
          </div>
        </div>
        <div class="cal" data-reveal>
          <div class="cal__grid" role="group" aria-label="Redaktionskalender, vier Wochen">
            <div class="cal__head" aria-hidden="true"><span></span>{days.map((d) => <span>{d}</span>)}</div>
            {calendar.map((w, wi) => (
              <div class="cal__week">
                <p class="cal__theme"><span class="idx">W{wi + 1}</span>{w.theme}</p>
                {days.map((d, di) => {
                  const it = w.items.find((x) => x.d === di);
                  return (
                    <div class="cal__day" data-empty={it ? undefined : ''}>
                      {it && (
                        <button type="button" class="cal__item" data-cal-type={it.type} aria-pressed={wi === 0 && di === 0 ? 'true' : 'false'} data-when={`Woche ${wi + 1} · ${d}`} data-kind={calTypeName[it.type]} data-title={it.title} data-format={it.format} data-to={it.to}>
                          <span class="cal__day-name">{d}</span><span class="cal__type">{calTypeName[it.type]}</span><span class="cal__title">{it.title}</span>
                        </button>
                      )}
                    </div>
                  );
                })}
              </div>
            ))}
          </div>
          <aside class="cal__detail" aria-live="polite">
            <p class="label label--gold"><span data-cal-when>Woche 1 · Mo</span> · <span data-cal-kind>{calTypeName[firstCal.type]}</span></p>
            <h3 data-cal-title>{firstCal.title}</h3>
            <dl>
              <div><dt>Format</dt><dd data-cal-format>{firstCal.format}</dd></div>
              <div><dt>Führt zu</dt><dd data-cal-to>{firstCal.to}</dd></div>
            </dl>
            <p class="cal__sum"><b>{calCount}</b> Inhalte in vier Wochen, alle aus Themen deiner Checkliste. Jeder Beitrag wird vorab von dir freigegeben.</p>
          </aside>
        </div>
      </section>

      <!-- ========== 10 · PAID ADVERTISING ========== -->
      <section class="chapter block wrap campaign" id="s10" data-chapter="s10" data-stop="10 · Paid Advertising" data-ad>
        <div class="ad-stage" data-parallax data-tilt>
          <article class="ad" data-format="feed">
            <header><Image src={avatar} alt="" width={64} densities={[1, 2]} loading="lazy" /><div><strong>teamneudorf_versicherungen</strong><span>Gesponsert</span></div></header>
            <div class="ad__media">
              {campaigns.flatMap((c, i) => c.creatives.map((cr, k) => <Image src={img[cr.img]} alt="" width={640} loading="eager" data-ad-img={`${c.id}${k}`} hidden={!(i === 0 && k === 0)} />))}
              <div class="ad__copy"><h3 data-ad-headline>{c0.creatives[0].headline}</h3><p data-ad-sub>{c0.creatives[0].sub}</p></div>
            </div>
            <footer><p data-ad-offer>{c0.offer}</p><span class="ad__cta" data-ad-cta>{c0.cta}</span></footer>
          </article>
          <p class="concept">Entwurf · keine geschaltete Anzeige</p>
        </div>
        <div>
          <p class="eyebrow" data-reveal>10 · Paid Advertising</p>
          <h2 class="h-xl" data-reveal>Drei Kampagnen. <em>Je zwei Creatives.</em></h2>
          <div class="chips" data-reveal>
            <div class="chips__group" role="tablist" aria-label="Kampagne wählen">
              {campaigns.map((c, i) => <button role="tab" type="button" id={`camp-tab-${c.id}`} aria-controls={`camp-${c.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-campaign={c.id} data-offer={c.offer} data-cta={c.cta} data-creatives={JSON.stringify(c.creatives)}>{c.tab} · {c.name}</button>)}
            </div>
            <div class="chips__group" role="group" aria-label="Creative">
              <button type="button" aria-pressed="true" data-creative="0">Creative 1</button>
              <button type="button" aria-pressed="false" data-creative="1">Creative 2</button>
            </div>
            <div class="chips__group" role="group" aria-label="Format">
              <button type="button" aria-pressed="true" data-ad-format="feed">Feed</button>
              <button type="button" aria-pressed="false" data-ad-format="story">Story</button>
            </div>
          </div>
          {campaigns.map((c, i) => (
            <div class="camp" role="tabpanel" id={`camp-${c.id}`} aria-labelledby={`camp-tab-${c.id}`} hidden={i !== 0}>
              <dl class="facts facts--two">
                <div><dt>Zielgruppe</dt><dd>{c.audience}</dd></div>
                <div><dt>Angebot</dt><dd>{c.offer}</dd></div>
                <div><dt>CTA</dt><dd>{c.cta}</dd></div>
                <div><dt>Weg</dt><dd>{c.path}</dd></div>
              </dl>
            </div>
          ))}
          <ul class="facts-mini">
            {adRules.map((r) => <li><span class={`tag tag--${r.tag}`}>{tagLabel[r.tag]}</span>{r.text}</li>)}
          </ul>
          <p class="fine">Motiv, Text, Zielgruppe und Budget gibst du frei, bevor etwas startet. Wir nennen keine Ergebnisse, bevor es echte gibt.</p>
        </div>
      </section>

      <!-- ========== 11 · WEG ZUR ANFRAGE ========== -->
      <section class="chapter block wrap" id="s11" data-chapter="s11" data-stop="11 · Weg zur Anfrage" data-routes>
        <p class="eyebrow" data-reveal>11 · Der Weg zur Beratungsanfrage</p>
        <h2 class="h-xl" data-reveal>Vom Reel zum Termin. <em>Ohne Pflichtschritte.</em></h2>
        <div class="switch" role="group" aria-label="Weg wählen" data-reveal>
          {routes.map((r, i) => <button type="button" aria-pressed={i === 0 ? 'true' : 'false'} data-route={r.id} data-nodes={r.nodes.join(' ')} data-note={r.note}>{r.label}</button>)}
        </div>
        <ol class="route" data-reveal data-active={routes[0].nodes.join(' ')}>
          {pathNodes.map((n, i) => (
            <li data-node={n.id} class:list={[{ 'is-on': (routes[0].nodes as readonly string[]).includes(n.id) }]}><span class="route__dot" aria-hidden="true"></span><span class="idx">0{i + 1}</span><strong>{n.label}</strong><p>{n.text}</p></li>
          ))}
        </ol>
        <p class="aside" data-route-note aria-live="polite">{routes[0].note}</p>
        <ul class="roles-strip" data-reveal>
          {Object.entries(reelRoles).map(([k, v]) => <li><span class="label label--gold">{v}</span>{reels.filter((r) => r.role === k).map((r) => <span class="roles-strip__reel">Reel {r.n}</span>)}</li>)}
        </ul>
        <p class="fine" data-reveal><span class="tag tag--idee">{tagLabel.idee}</span> Die Checkliste bleibt ohne Pflichtangaben. Daten erheben wir nur, wenn jemand selbst Kontakt aufnimmt, und nur so viele wie nötig. Datenschutzhinweise und Erstinformation prüft vor dem Start eine Fachperson.</p>
      </section>

      <!-- ========== 12 · AUTOMATISIERUNG ========== -->
      <section class="chapter block wrap" id="s12" data-chapter="s12" data-stop="12 · Automatisierung" data-workflows>
        <p class="eyebrow" data-reveal>12 · Automatisierung des Marketings</p>
        <h2 class="h-xl" data-reveal>Routine macht die Maschine. <em>Entscheidungen machen Menschen.</em></h2>
        <div class="switch" role="group" aria-label="Workflow wählen" data-reveal>
          {workflows.map((w, i) => <button type="button" aria-pressed={i === 0 ? 'true' : 'false'} data-workflow={w.id}>{w.label}</button>)}
        </div>
        {workflows.map((w, i) => (
          <ol class="process process--6" data-flow={w.id} hidden={i !== 0}>
            {w.steps.map((s, k) => (
              <li data-level={s.level} style={`--k:${k}`}><span class="process__n">0{k + 1}</span><h3>{s.title}</h3><p>{s.text}</p><span class={`label level level--${s.level}`}>{levelName[s.level]}</span></li>
            ))}
          </ol>
        ))}
        <p class="fine" data-reveal><span class="concept concept--inline">Konzept · nichts davon ist eingerichtet</span> Werkzeuge wählen wir gemeinsam, mit Vertrag zur Auftragsverarbeitung. Fachliche Inhalte werden nie automatisch veröffentlicht.</p>
      </section>

      <!-- ========== 13 · DEIN ZEITAUFWAND ========== -->
      <section class="chapter block wrap" id="s13" data-chapter="s13" data-stop="13 · Dein Zeitaufwand">
        <p class="eyebrow" data-reveal>13 · Wie viel Zeit musst du investieren?</p>
        <h2 class="h-xl" data-reveal>Du bleibst Experte. <em>Nicht Vollzeit-Creator.</em></h2>
        <div class="share">
          <article class="share__you" data-reveal>
            <p class="label label--gold">Dein Anteil</p>
            <ol>{effort.stefan.map((r, i) => <li><span class="idx">0{i + 1}</span><div><h3>{r.title}</h3><p>{r.text}</p></div></li>)}</ol>
            <p class="share__phase"><span>Phase A</span> Freigaben, kein Dreh · <span>ab Phase B</span> plus ein Drehtermin pro Monat</p>
          </article>
          <article class="share__us" data-reveal style="--i:1">
            <p class="label">Unser Anteil, im vereinbarten Umfang</p>
            <ul>{effort.wir.map((r) => <li>{r}</li>)}</ul>
          </article>
        </div>
        <p class="fine" data-reveal>Der konkrete Umfang wird vertraglich festgelegt. Vieles lässt sich automatisieren, aber nicht alles: Freigaben, Beratung und Entscheidungen bleiben bei Menschen.</p>
      </section>

      <!-- ========== 14 · ERFOLGSMESSUNG ========== -->
      <section class="chapter block wrap" id="s14" data-chapter="s14" data-stop="14 · Erfolgsmessung" data-dash={JSON.stringify(dashData)}>
        <p class="eyebrow" data-reveal>14 · Erfolgsmessung</p>
        <h2 class="h-xl" data-reveal>Wir zählen Gespräche, <em>nicht Likes.</em></h2>
        <div class="dash" data-reveal>
          <header class="dash__head">
            <p class="dash__demo">Demo-Daten · frei erfunden, um die Auswertung zu erklären</p>
            <div class="switch" role="group" aria-label="Kampagne wählen">
              {dashData.map((d, i) => <button type="button" aria-pressed={i === 0 ? 'true' : 'false'} data-dash-set={d.id}>{d.name}</button>)}
            </div>
          </header>
          <ul class="dash__kpis">
            <li><span class="label">Werbekosten</span><b data-kpi="spend">{d0.spend} €</b><small>{kpiSources.spend}</small></li>
            <li><span class="label">Qualifizierte Anfragen</span><b data-kpi="qualified">{d0.qualified}</b><small>{kpiSources.qualified}</small></li>
            <li class="is-key"><span class="label">Kosten je qualifizierter Anfrage</span><b data-kpi="cpl">–</b><small>{kpiSources.cpl}</small></li>
            <li><span class="label">Beratungstermine</span><b data-kpi="booked">{d0.booked}</b><small>{kpiSources.booked}</small></li>
            <li><span class="label">Wahrgenommen</span><b data-kpi="attended">{d0.attended}</b><small>{kpiSources.attended}</small></li>
            <li><span class="label">Gewonnene Kunden</span><b data-kpi="customers">{d0.customers}</b><small>{kpiSources.customers}</small></li>
          </ul>
          <div class="dash__body">
            <ol class="funnel" aria-label="Von der Anfrage zum Kunden (Demo)">
              {[['leads', 'Anfragen'], ['qualified', 'Qualifiziert'], ['booked', 'Gebucht'], ['attended', 'Wahrgenommen'], ['customers', 'Kunden']].map(([k, l]) => (
                <li data-funnel={k}><span class="funnel__label">{l}</span><span class="funnel__bar"><i></i></span><b></b></li>
              ))}
            </ol>
            <aside class="dash__verdict" aria-live="polite">
              <p class="label label--gold">So lesen wir das</p>
              <p class="dash__verdict-text" data-dash-verdict>{d0.verdict}</p>
              <p class="label">Nächster Schritt</p>
              <p data-dash-action>{d0.action}</p>
            </aside>
          </div>
        </div>
        <p class="fine" data-reveal>Ob aus einem Gespräch ein Kunde wird, weißt nur du. Diese Zahl kommt von dir, nicht aus einem Werkzeug.</p>
      </section>

      <!-- ========== 15 · 90-TAGE-PILOT ========== -->
      <section class="chapter" id="s15" data-chapter="s15">
        <div class="block wrap" data-stop="15 · 90-Tage-Pilot" data-roadmap>
          <p class="eyebrow" data-reveal>15 · Die 90-Tage-Pilotphase</p>
          <h2 class="h-xl" data-reveal>KI-first starten. <em>Nach 90 Tagen gemeinsam entscheiden.</em></h2>
          <div class="roadmap" data-reveal style={`--n:${roadmap.length}`}>
            <div class="roadmap__track" aria-hidden="true"><i></i></div>
            <div class="roadmap__steps" role="tablist" aria-label="Pilotphase">
              {roadmap.map((r, i) => (
                <button role="tab" type="button" id={`r-tab-${i}`} aria-controls={`r-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-phase={i}><span class="roadmap__node" aria-hidden="true"></span><span class="label">{r.days}</span><strong>{r.title}</strong></button>
              ))}
            </div>
            {roadmap.map((r, i) => (
              <div class="roadmap__panel roadmap__panel--split" role="tabpanel" id={`r-${i}`} aria-labelledby={`r-tab-${i}`} hidden={i !== 0}>
                <div><p class="label">Wir</p><ul>{r.wir.map((t) => <li>{t}</li>)}</ul></div>
                <div><p class="label label--gold">Du</p><ul>{r.stefan.map((t) => <li>{t}</li>)}</ul></div>
                <p>{r.result}</p>
              </div>
            ))}
          </div>
          <div class="costs" data-reveal>
            <p class="label">Kostenarten im Pilot</p>
            <ul>{costTypes.map((c) => <li>{c}</li>)}</ul>
          </div>
        </div>

        <div class="closing" data-stop="Einladung">
          <canvas class="closing__dots" data-halftone aria-hidden="true"></canvas>
          <div class="wrap closing__grid">
            <div>
              <p class="eyebrow" data-reveal>Der nächste Schritt</p>
              <h2 class="closing__title" data-reveal>Lass es uns <em>gemeinsam umsetzen.</em></h2>
              <ol class="questions">
                {questions.map((q, i) => <li data-reveal style={`--i:${i}`}><span class="idx">0{i + 1}</span>{q}</li>)}
              </ol>
              <div class="hero__actions" data-reveal><a class="cta cta--ghost" href="#start">Zurück zum Anfang</a><button class="cta cta--ghost" type="button" data-open-index>Stationsübersicht</button></div>
            </div>
            <figure class="closing__avatar" data-parallax data-reveal><Image src={avatar} alt="Stefan Neudorf" width={420} densities={[1, 2]} loading="lazy" /></figure>
          </div>
          <p class="wrap closing__legal">Konzept für eine mögliche Zusammenarbeit. Alle Mockups, Anzeigen, Szenen und Pläne sind Entwürfe; nichts davon ist veröffentlicht oder eingerichtet. Das Cockpit zeigt Demo-Daten. Fachliche Aussagen stammen aus Stefans Checkliste für Beamtenanwärter in NRW und brauchen vor jeder Veröffentlichung seine Freigabe. Reichweiten und Plattformangaben mit Quelle und Datum, Stand November 2026; sie ersetzen keine rechtliche Prüfung.</p>
        </div>
      </section>
    </main>

    <script>
      import '../scripts/vision.ts';
    </script>
  </body>
</html>
